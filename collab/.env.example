# ═══ collab/ — dịch vụ cộng tác thời gian thực (Hocuspocus + Yjs) ═══════════════
# Sao chép thành `.env` để chạy cục bộ (`npm run dev`). KHÔNG commit `.env`.
# Mọi biến đọc/kiểm ở `src/config.ts` (Zod); thiếu/sai → thoát ngay với thông báo nêu TÊN khoá.

NODE_ENV=development
LOG_LEVEL=info

# ── Mạng ─────────────────────────────────────────────────────────────────────
# Một cổng phục vụ cả WebSocket (mọi path trừ /internal, /health, /metrics), /health, /metrics và /internal/*.
PORT=4000
HOST=0.0.0.0
# `true` khi đứng sau nginx: IP client = phần tử CUỐI của X-Forwarded-For (một proxy tin cậy). Dùng cho giới hạn theo IP.
TRUST_PROXY=false

# ── Liên kết với BE (BẮT BUỘC) ───────────────────────────────────────────────
# Gốc URL của BE (không kèm /api). Docker compose: http://api:3000
BE_INTERNAL_URL=http://localhost:3000
# Bí mật dùng chung với BE (`be/.env` COLLAB_SHARED_SECRET) — ≥ 32 ký tự, KHÁC JWT_SECRET, khác nhau giữa dev/staging/prod.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLLAB_SHARED_SECRET=
# Thời gian chờ mỗi lời gọi BE + số lần thử lại (chỉ lỗi mạng/5xx/429).
BE_TIMEOUT_MS=5000
BE_RETRIES=2

# ── Nhiều instance (tuỳ chọn) ────────────────────────────────────────────────
# Đặt REDIS_URL → bật @hocuspocus/extension-redis (đồng bộ update/awareness giữa instance + khoá khi lưu) và kênh bus cho lệnh kick.
# Để trống = chạy MỘT instance.
REDIS_URL=
REDIS_KEY_PREFIX=superapp:collab:
# Tên instance trong log/metric/Redis (mặc định: hostname-pid).
INSTANCE_ID=

# ── Loại tài nguyên phục vụ ──────────────────────────────────────────────────
# document (p6-01). Thêm whiteboard khi BE có module whiteboards (p6-02).
COLLAB_KINDS=document

# ── Lưu về BE (BE là nguồn duy nhất, không cache đĩa) ────────────────────────
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=60000
# BE lỗi → giữ state trong RAM và thử lại với backoff (gốc → trần).
STORE_RETRY_BASE_MS=2000
STORE_RETRY_MAX_MS=60000
# Trần số document được giữ trong RAM chỉ vì chưa lưu được (BE sập lâu). Vượt → bỏ cái cũ nhất + log lỗi + metric.
PENDING_MAX_DOCS=500

# ── Giới hạn/bảo vệ ──────────────────────────────────────────────────────────
MAX_CONNECTIONS_PER_DOC=50
MAX_CONNECTIONS_PER_USER_PER_DOC=10
MAX_CONNECTIONS_PER_IP=1000
# Trần một khung WebSocket (byte) — phải > trần state của tài liệu (5 MiB). Chỉ áp cho khung client GỬI LÊN: bảng trắng (trần state 9 MiB)
# nạp state lớn từ BE bình thường, nhưng client không đẩy nổi một update > giá trị này trong một khung (bị đóng 1009) — nâng lên nếu cần.
WS_MAX_PAYLOAD_BYTES=6291456
MAX_MESSAGES_PER_SECOND=200
# Trần tần suất awareness (con trỏ/bản nháp kéo) của BẢNG TRẮNG, lần/giây/kết nối. Client throttle ≤ 30 Hz nên 60 là dư gấp đôi.
# Vượt → server BỎ bớt tin (không đóng kết nối, đếm ở collab_awareness_dropped_total). Chỉ tin có state của CHÍNH kết nối được tính
# (tin phản hồi lại state người khác và tin rời không tính). Chỉ áp cho kind whiteboard; số nguyên ≥ 1.
WB_AWARENESS_MAX_HZ=60
AUTH_TIMEOUT_MS=10000
WS_PING_TIMEOUT_MS=30000
MAX_FAILED_AUTH_PER_IP_PER_MINUTE=30

# ── Quyền ────────────────────────────────────────────────────────────────────
# Đệm kết quả kiểm quyền (thu hồi quyền có hiệu lực ≤ giá trị này nếu tin kick thất lạc) và chu kỳ kiểm lại mọi kết nối (0 = tắt).
ACCESS_CACHE_TTL_MS=30000
ACCESS_RECHECK_MS=30000

# ── Vận hành ─────────────────────────────────────────────────────────────────
SHUTDOWN_GRACE_MS=25000
# Có → GET /metrics yêu cầu `Authorization: Bearer <token>`. Để trống: mở (chỉ mạng nội bộ).
METRICS_TOKEN=
SENTRY_DSN=
APP_VERSION=0.1.0
