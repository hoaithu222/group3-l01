{
  "name": "super-app-collab",
  "version": "0.1.0",
  "private": true,
  "description": "Super App — dịch vụ cộng tác thời gian thực (Hocuspocus + Yjs). Dùng chung cho Real-time Docs (p6-01) và Whiteboard (p6-02).",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@hocuspocus/extension-redis": "3.4.4",
    "@hocuspocus/server": "3.4.4",
    "@sentry/node": "^10.75.3",
    "express": "^4.22.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lib0": "^0.2.118",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hocuspocus/provider": "3.4.4",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
