  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum MentorEngagementStatus {
  ACTIVE
  ENDED
}

enum MentorEndReason {
  EXPIRED
  ENDED_BY_OWNER
  LEFT_BY_MENTOR
  MEMBERSHIP_REVOKED
  WORKSPACE_ARCHIVED
  /// Quản trị nền tảng kết thúc (`POST /admin/mentor/engagements/:id/end`).
  ENDED_BY_PLATFORM
