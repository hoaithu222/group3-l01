model MentorPost {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId            String           @db.ObjectId
  createdBy              String           @db.ObjectId
  title                  String
  normalizedTitle        String
  description            String
  /// Kỹ năng đã chuẩn hoá (`normalizeSearch`) để lọc; `skillLabels` giữ nhãn gốc để hiển thị (cùng thứ tự).
  skills                 String[]
  skillLabels            String[]
