// ── p6-05 o2o ── In ấn O2O & địa điểm (module `o2o`). `Location.geo` là GeoJSON Point [lng, lat] — index `2dsphere` KHÔNG khai được
// bằng Prisma: tạo bằng `npm run db:ensure-indexes` (scripts/ensure-indexes.ts, idempotent) NGAY SAU `db push`. Chủ tiệm (`PrintShop`
// APPROVED) nhận quyền theo dữ liệu `partner:*` (provider `print-shop`). Đơn in snapshot tệp (`fileAssetId`) lúc tạo + báo giá (`quote`)
// lúc gửi; PIN chỉ lưu HMAC. Field lọc bằng `null` (`hiddenAt`, `fileAccessUntil`, `expiringNotifiedAt`…) luôn ghi null TƯỜNG MINH khi tạo.
enum LocationType {
  CAFE
  PRINT_SHOP
  LIBRARY
}

enum LocationStatus {
  ACTIVE
  HIDDEN
}

type GeoPoint {
  type        String
  /// [lng, lat] — thứ tự GeoJSON.
  coordinates Float[]
}

type OpenHour {
  /// 0 = Chủ nhật … 6 = Thứ bảy.
  day   Int
  /// "07:00" (giờ địa phương `LIMITS.o2o.timezone`).
  open  String
  close String
}

model Location {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  normalizedName String
  address        String
  geo            GeoPoint
  type           LocationType
  /// Mã tiện ích (`LIMITS.o2o.amenities`).
  amenities      String[]
  openHours      OpenHour[]
  photoAssetIds  String[]       @db.ObjectId
  ratingAvg      Float          @default(0)
  ratingCount    Int            @default(0)
  noiseAvg       Float          @default(0)
  status         LocationStatus @default(ACTIVE)
  hiddenReason   String?
  createdBy      String         @db.ObjectId
  version        Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([type, status])
  @@index([status, normalizedName])
}

model LocationReview {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  locationId String    @db.ObjectId
  userId     String    @db.ObjectId
  rating     Int
  noise      Int
  comment    String?
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([locationId, userId])
  @@index([locationId, createdAt])
}

enum PrintShopStatus {
  PENDING
  APPROVED
  SUSPENDED
}

/// Đồng/trang (số nguyên).
