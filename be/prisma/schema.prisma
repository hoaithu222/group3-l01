// ── p7-04 chat-extensions ── Mở rộng chat (module `chat-extensions`): khảo sát, tin hẹn giờ, nhắc lại tin. Module KHÔNG ghi thẳng collection `Message`: tạo tin qua cổng
// `IMessageSendPort` (kind POLL/USER), tạo thẻ/tài liệu qua `ITaskCreationPort`/`IResourceCreationPort`. Đếm phiếu phi chuẩn hoá trong `Poll.options[].voteCount` + `voterCount`
// (CAS `version`, cập nhật cùng transaction với `PollVote`); `PollVote.userId` lưu cả khi ẩn danh để chống bầu trùng nhưng KHÔNG bao giờ trả ra API.
enum PollStatus {
  OPEN
  CLOSED
}

enum PollCloseReason {
  EXPIRED
  BY_CREATOR
  BY_MODERATOR
  MESSAGE_RECALLED
}

type PollOption {
  /// 8 ký tự ngẫu nhiên, ổn định (khoá lựa chọn trong `PollVote.optionIds`).
  id        String
  text      String
  voteCount Int     @default(0)
  /// P1: người tham gia thêm lựa chọn.
  addedBy   String? @db.ObjectId
}

model Poll {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  /// Tin `kind = POLL` mang khảo sát này (1-1).
  messageId          String           @unique @db.ObjectId
  scopeType          MessageScopeType
  scopeId            String           @db.ObjectId
  threadId           String?          @db.ObjectId
  workspaceId        String?          @db.ObjectId
  createdBy          String           @db.ObjectId
  question           String
  normalizedQuestion String
  options            PollOption[]
  /// Cho chọn nhiều đáp án.
  multi              Boolean          @default(false)
  /// Ẩn danh: API không trả danh sách người bầu cho ai (kể cả người tạo).
  anonymous          Boolean          @default(false)
  /// P1.
  allowAddOptions    Boolean          @default(false)
  closesAt           DateTime?
  status             PollStatus       @default(OPEN)
  closedAt           DateTime?
  closedBy           String?          @db.ObjectId
  closeReason        PollCloseReason?
  voterCount         Int              @default(0)
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([scopeType, scopeId, createdAt])
  @@index([status, closesAt])
  @@index([createdBy, createdAt])
}

model PollVote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  pollId    String   @db.ObjectId
  /// Lưu cả khi khảo sát ẩn danh — chống bầu trùng; KHÔNG trả ra API.
  userId    String   @db.ObjectId
  optionIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pollId, userId])
  /// `GET /polls/:id/voters?optionId`.
  @@index([pollId, optionIds, updatedAt])
}

enum ScheduledMessageStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ScheduledFailReason {
  NO_PERMISSION
  SCOPE_ARCHIVED
  BLOCKED
  ATTACHMENT_INVALID
  SUB_FEATURE_OFF
  AUTHOR_INACTIVE
  UNKNOWN
}

/// Tin chờ phát (CHƯA phải `Message` — không lộ trong lịch sử trước giờ phát). Đến hạn job `scheduled-message.send` tạo `Message` qua `IMessageSendPort` với `clientMessageId = "sched:<id>"`.
model ScheduledMessage {
  id                 String                 @id @default(auto()) @map("_id") @db.ObjectId
  authorId           String                 @db.ObjectId
  scopeType          MessageScopeType
  scopeId            String                 @db.ObjectId
  threadId           String?                @db.ObjectId
  workspaceId        String?                @db.ObjectId
  content            String?
  mentions           MessageMention[]
  /// Tệp giữ bằng `AssetLink(targetType SCHEDULED_MESSAGE, scope NONE)` để job dọn mồ côi không xoá trong lúc chờ phát.
  attachmentAssetIds String[]               @db.ObjectId
  replyToId          String?                @db.ObjectId
  /// UTC đã chốt lúc hẹn.
  sendAt             DateTime
  /// IANA lúc hẹn — CHỈ để hiển thị.
  timezone           String
  status             ScheduledMessageStatus @default(PENDING)
  messageId          String?                @db.ObjectId
  failReason         ScheduledFailReason?
  /// Mã lỗi của engine tin nhắn (MSG_005…).
  failCode           String?
  attempts           Int                    @default(0)
  sentAt             DateTime?
  cancelledAt        DateTime?
  version            Int                    @default(1)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([authorId, status, sendAt])
  @@index([status, sendAt])
  @@index([status, updatedAt])
  @@index([scopeType, scopeId, status])
}

enum MessageReminderStatus {
  PENDING
  FIRED
  CANCELLED
}

model MessageReminder {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  userId         String                @db.ObjectId
  messageId      String                @db.ObjectId
  scopeType      MessageScopeType
  scopeId        String                @db.ObjectId
  workspaceId    String?               @db.ObjectId
  remindAt       DateTime
  timezone       String
  status         MessageReminderStatus @default(PENDING)
  firedAt        DateTime?
  /// Tin đã gỡ / mất quyền đọc lúc đến hạn → thông báo chung ("Tin không còn khả dụng"), không lộ nội dung.
  unavailable    Boolean               @default(false)
  notificationId String?               @db.ObjectId
  cancelledAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId, status, remindAt])
  @@index([status, remindAt])
  @@index([messageId])
}

// ── p6-01 documents ── Real-time Docs (module `documents`): metadata + trạng thái Yjs. BE là NGUỒN DUY NHẤT của `yjsState` — service `collab/`
// (Hocuspocus) chỉ tải/lưu qua `/api/internal/documents/:id/state`, không có kết nối Mongo riêng. Mongo giới hạn 16 MB/document → `LIMITS.document.stateMaxBytes` 5 MiB.
enum DocumentVisibility {
  WORKSPACE
  PRIVATE
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

model Document {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String             @db.ObjectId
  title           String
  normalizedTitle String
  visibility      DocumentVisibility @default(WORKSPACE)
  status          DocumentStatus     @default(ACTIVE)
  /// Yjs update đầy đủ (Y.encodeStateAsUpdate) của Y.XmlFragment `default` (Tiptap Collaboration); `null` = chưa ai gõ.
  yjsState        Bytes?
  /// Tăng mỗi lần ghi state (collab lưu / khôi phục snapshot) — khoá dedupe job `document.plaintext`, base version để BE hợp nhất khi collab lưu chậm.
  yjsVersion      Int                @default(0)
  /// Kích thước `yjsState` (byte) — admin xếp hạng "tài liệu lớn" mà không phải tải state.
  stateBytes      Int                @default(0)
  /// Văn bản phẳng trích từ Yjs (job `document.plaintext`, ≤ 100 KB) phục vụ tìm kiếm workspace (p5-04).
  plainText       String             @default("")
  normalizedText  String             @default("")
  wordCount       Int                @default(0)
  lastEditedBy    String?            @db.ObjectId
  lastEditedAt    DateTime?
  createdBy       String             @db.ObjectId
  /// Phiên bản OPTIMISTIC của METADATA (đổi tên/visibility/lưu trữ/khôi phục snapshot) — khác `yjsVersion` (nội dung).
  version         Int                @default(1)
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, normalizedTitle])
  @@index([status, lastEditedAt])
  @@index([stateBytes])
}

enum DocumentCollaboratorRole {
  EDITOR
  VIEWER
}

/// Người được mời vào tài liệu (bắt buộc với tài liệu PRIVATE; với WORKSPACE chỉ cần cho khách GUEST). Người tạo KHÔNG có dòng ở đây.
model DocumentCollaborator {
  id         String                   @id @default(auto()) @map("_id") @db.ObjectId
  documentId String                   @db.ObjectId
  userId     String                   @db.ObjectId
  role       DocumentCollaboratorRole @default(EDITOR)
  addedBy    String                   @db.ObjectId
  createdAt  DateTime                 @default(now())

  @@unique([documentId, userId])
  @@index([userId])
}

enum DocumentSnapshotKind {
  AUTO
  MANUAL
  PRE_RESTORE
}

/// Bản chụp state Yjs để xem/khôi phục: AUTO (cron mỗi giờ nếu có thay đổi, giữ 30), MANUAL (người dùng, ≤ 100), PRE_RESTORE (tự tạo trước khi khôi phục, giữ vài bản gần nhất).
model DocumentSnapshot {
  id         String               @id @default(auto()) @map("_id") @db.ObjectId
  documentId String               @db.ObjectId
  kind       DocumentSnapshotKind
  label      String?
  yjsState   Bytes
  yjsVersion Int
  sizeBytes  Int
  createdBy  String?              @db.ObjectId
  at         DateTime             @default(now())

  @@index([documentId, at])
  @@index([documentId, kind, at])
}

// ── p6-08 recruiter ── Recruiter board (module `recruiter`): doanh nghiệp tự đăng ký (PENDING → vận hành duyệt) → tìm sinh viên đã bật Open to work trên
// `TalentSearchIndex` (bản chiếu đã lọc quyền riêng tư) → gửi lời mời (hạn mức tháng nguyên tử) → sinh viên Quan tâm / Từ chối / Chặn → trao đổi trong lời mời.
// ⚠ Unique + Mongo: index unique KHÔNG bỏ qua giá trị vắng/null (chỉ một tài liệu "không có" được phép) nên mọi khoá unique dưới đây là chuỗi KHÔNG BAO GIỜ null:
// `taxCodeKey` = "none:<companyId>" khi không có MST hoặc công ty bị REJECTED (nhả khoá cho người khác đăng ký lại), `nameKey` = "rejected:<companyId>" khi REJECTED,
// `CompanyMember.activeKey` = "<userId>" khi ACTIVE / "removed:<memberId>" khi REMOVED, `JobOffer.activeKey` = "<companyId>:<studentId>" khi còn mở / "closed:<offerId>".
// Khoá unique cần `npm run db:push` (Mongo in-memory của test tự `createIndexes`).
enum CompanyTier {
  FREE
  PRO
  ENTERPRISE
}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CompanySize {
  S1_10
  S11_50
  S51_200
  S201_1000
  S1000_PLUS
}

model Company {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  normalizedName     String
  /// `normalizeSearch(name)` bỏ khoảng trắng — chống trùng tên; "rejected:<id>" khi REJECTED (nhả khoá, đăng ký lại/gửi duyệt lại tranh khoá lúc `resubmit`).
  nameKey            String        @unique
  taxCode            String?
  /// MST chuẩn hoá (bỏ dấu gạch) — "none:<id>" khi không có MST hoặc khi REJECTED.
  taxCodeKey         String        @unique
  website            String
  /// Tên miền của website — vận hành đối chiếu với email của thành viên khi duyệt.
  emailDomain        String?
  description        String?
  logoAssetId        String?       @db.ObjectId
  industry           String?
  sizeRange          CompanySize?
  tier               CompanyTier   @default(FREE)
  /// Ghi đè hạn mức lời mời/tháng (null = theo gói trong `SystemConfig recruiter.offerQuotaByTier`).
  offerQuotaOverride Int?
  status             CompanyStatus @default(PENDING)
  /// Lý do của lần duyệt/từ chối/tạm ngưng gần nhất — OWNER thấy khi REJECTED/SUSPENDED (không lộ người xử lý).
  statusReason       String?
  reviewedBy         String?       @db.ObjectId
  reviewedAt         DateTime?
  /// Số báo cáo đang mở (đặt tuyệt đối bởi `onReportCreated`) — vận hành thấy ở danh sách.
  reportedCount      Int           @default(0)
  createdBy          String        @db.ObjectId
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([normalizedName])
}

enum CompanyMemberRole {
  OWNER
  RECRUITER
}

enum CompanyMemberStatus {
  ACTIVE
  REMOVED
}

/// Nhân sự doanh nghiệp. Một người ≤ 1 doanh nghiệp (P0) nhờ `activeKey` unique; thêm lại người đã REMOVED = kích hoạt LẠI hàng cũ (`@@unique [companyId, userId]`).
model CompanyMember {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  companyId String              @db.ObjectId
  userId    String              @db.ObjectId
  role      CompanyMemberRole
  status    CompanyMemberStatus @default(ACTIVE)
  activeKey String              @unique
  invitedBy String?             @db.ObjectId
  joinedAt  DateTime            @default(now())
  removedAt DateTime?

  @@unique([companyId, userId])
  @@index([userId, status])
  @@index([companyId, status])
}

/// Đếm lời mời đã gửi theo tháng ("YYYY-MM" theo Asia/Ho_Chi_Minh) — `updateMany where used < quota` + `$inc` nên gửi song song không vượt hạn mức, không cần job reset tháng.
model CompanyOfferUsage {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  companyId String @db.ObjectId
  period    String
  used      Int    @default(0)

  @@unique([companyId, period])
}

enum JobOfferStatus {
  SENT
  READ
  INTERESTED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum EmploymentType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  FREELANCE
}

enum OfferDeclineReason {
  NOT_LOOKING
  NOT_A_FIT
  LOCATION
  TIMING
  OTHER
}

/// Lời mời việc làm. `activeKey` giữ "<companyId>:<studentId>" khi SENT|READ|INTERESTED (mỗi cặp ≤ 1 lời mời mở), "closed:<id>" khi đã đóng.
/// `sharedEmail` = ảnh chụp email sinh viên chọn chia sẻ lúc Quan tâm (không bao giờ tự lộ). Đếm chưa đọc của thread tách theo bên (`studentUnread`/`companyUnread`).
model JobOffer {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  companyId       String              @db.ObjectId
  recruiterId     String              @db.ObjectId
  studentId       String              @db.ObjectId
  title           String
  message         String
  employmentType  EmploymentType
  location        String?
  jdAssetId       String?             @db.ObjectId
  status          JobOfferStatus      @default(SENT)
  activeKey       String              @unique
  /// `Idempotency-Key` của yêu cầu gửi (hoặc "gen:<id>" khi client không gửi) — (recruiterId, clientRequestId) unique.
  clientRequestId String
  sharedEmail     String?
  declineReason   OfferDeclineReason?
  threadLocked    Boolean             @default(false)
  studentUnread   Int                 @default(0)
  companyUnread   Int                 @default(0)
  reportedCount   Int                 @default(0)
  sentAt          DateTime            @default(now())
  readAt          DateTime?
  respondedAt     DateTime?
  withdrawnAt     DateTime?
  expiresAt       DateTime
  lastMessageAt   DateTime?
  version         Int                 @default(1)

  @@unique([recruiterId, clientRequestId])
  @@index([studentId, status, sentAt])
  @@index([companyId, sentAt])
  @@index([status, expiresAt])
}

enum OfferMessageSide {
  COMPANY
  CANDIDATE
}

/// Tin trao đổi trong lời mời (mở sau INTERESTED). Chỉ chữ; `(authorId, clientMessageId)` unique → gửi lại cùng id trả bản cũ.
model JobOfferMessage {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  offerId         String           @db.ObjectId
  authorId        String           @db.ObjectId
  side            OfferMessageSide
  content         String
  clientMessageId String
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?

  @@unique([authorId, clientMessageId])
  @@index([offerId, createdAt])
}

type TalentSkillRef {
  skillId String @db.ObjectId
  code    String
  name    String
  icon    String
}

/// Bản chiếu tìm kiếm (materialized) của ứng viên đã bật Open to work — dựng LẠI toàn bộ theo `userId` (idempotent) và ĐÃ lọc quyền riêng tư lúc dựng
/// (`showSkills`/`showContribution`); HR tìm CHỈ trên bảng này, không truy vấn dữ liệu nghiệp vụ. Không email/SĐT/tên nhóm.
model TalentSearchIndex {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String           @unique @db.ObjectId
  openToWork             Boolean
  displayName            String
  /// `normalizeSearch([displayName, headline, preferredRoles, location].join(" "))` — khớp tiền tố từ.
  normalizedText         String
  avatarAssetId          String?          @db.ObjectId
  headline               String?
  preferredRoles         String[]
  /// Vị trí mong muốn chuẩn hoá (`normalizeSearch`) — lọc `role`.
  preferredRolesKey      String[]
  location               String?
  locationKey            String?
  skillCodes             String[]
  skills                 TalentSkillRef[]
  badgeCount             Int              @default(0)
  /// Điểm đóng góp ×10 (null khi `showContribution=false` hoặc chưa nhóm nào đủ dữ liệu).
  contributionPctX10     Int?
  contributionWorkspaces Int?
  portfolioUrl           String?
  /// Doanh nghiệp bị người này chặn — `$ne companyId` khi tìm, được đồng bộ ngay lúc chặn.
  blockedCompanyIds      String[]         @db.ObjectId
  sourceUpdatedAt        DateTime
  rebuiltAt              DateTime         @default(now())

  @@index([openToWork, skillCodes])
  @@index([openToWork, contributionPctX10])
  @@index([openToWork, rebuiltAt])
}

/// Lượt xem hồ sơ ứng viên gộp theo (doanh nghiệp, sinh viên, ngày theo Asia/Ho_Chi_Minh) — sinh viên thấy "doanh nghiệp đã xem hồ sơ" (P1); mỗi lượt xem còn ghi `AuditLog talent.profile-view`.
model TalentProfileView {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  companyId    String   @db.ObjectId
  studentId    String   @db.ObjectId
  dayKey       String
  viewCount    Int      @default(0)
  recruiterIds String[] @db.ObjectId
  lastViewedAt DateTime

  @@unique([companyId, studentId, dayKey])
  @@index([studentId, lastViewedAt])
}

/// Sinh viên chặn doanh nghiệp: không thấy trong tìm kiếm, không gửi được lời mời, thread cũ chỉ đọc.
model CompanyBlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  companyId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

// ── p6-07 portfolio ── Portfolio một chạm (module `portfolio`): hồ sơ công khai dựng từ dữ liệu hệ thống → BE render HTML tĩnh (Eta) → storage
// (`PORTFOLIO_STORAGE_PREFIX/<portfolioId>/b<buildVersion>/`) → `GET /p/:slug` (ngoài `/api`). Số liệu là SNAPSHOT bất biến (`PortfolioProject.snapshot`,
// điểm/phần trăm lưu ×10 số nguyên `…X10`) chụp lúc thêm/làm mới và chụp lại lúc Publish. Object build KHÔNG phải `Asset` (sản phẩm dẫn xuất công khai).
// Field lọc bằng `null` (`takenDownAt`, `currentBuildVersion`, `finishedAt`…) luôn ghi null TƯỜNG MINH khi tạo (Prisma-Mongo không khớp field vắng mặt).
// Unique cần `db push`: `Portfolio.userId`, `Portfolio.slugKey`, `PortfolioProject[portfolioId, workspaceId]`, `PortfolioBuild[portfolioId, buildVersion]`,
// `PortfolioSlugReservation.slugKey`.
enum PortfolioTemplate {
  CLASSIC
  DEVELOPER
  DESIGNER
  MINIMAL
}

enum PortfolioAccent {
  GREEN
  BLUE
  VIOLET
  ORANGE
  ROSE
  SLATE
}

enum PortfolioSectionKind {
  ABOUT
  PROJECTS
  SKILLS
  CONTACT
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

/// Liên kết ngoài hiển thị trên trang (chỉ `https://`).
type PortfolioLink {
  label String
  url   String
}

type PortfolioTheme {
  template PortfolioTemplate
  accent   PortfolioAccent
}

type PortfolioSection {
  kind    PortfolioSectionKind
  visible Boolean
  order   Int
}

model Portfolio {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  userId              String             @unique @db.ObjectId
  /// Slug hiển thị (hiện luôn chữ thường — `slugKey` là khoá tra cứu/unique).
  slug                String
  slugKey             String             @unique
  displayName         String
  headline            String?
  bio                 String?
  /// null → dùng ảnh đại diện tài khoản lúc build; có giá trị → asset scope AVATAR do chính chủ tải lên (`AssetLink PORTFOLIO`, targetId = portfolioId).
  avatarAssetId       String?            @db.ObjectId
  links               PortfolioLink[]
  theme               PortfolioTheme
  sections            PortfolioSection[]
  /// Cho phép công cụ tìm kiếm lập chỉ mục (mặc định false → `noindex`).
  seoIndexable        Boolean            @default(false)
  status              PortfolioStatus    @default(DRAFT)
  /// Build đang được phục vụ (chỉ tăng — build cũ về muộn không ghi đè).
  currentBuildVersion Int?
  /// Số phiên bản build kế tiếp (`$inc` nguyên tử khi Publish/build lại).
  nextBuildVersion    Int                @default(1)
  publishedAt         DateTime?
  unpublishedAt       DateTime?
  takenDownAt         DateTime?
  takenDownBy         String?            @db.ObjectId
  takedownReason      String?
  /// CAS của sửa hồ sơ/slug/Publish (`expectedVersion`). Sửa dự án KHÔNG tăng (dự án có `version` riêng).
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([status])
}

/// Huy hiệu tham chiếu (P1 — ở P0 mục SKILLS lấy thẳng huy hiệu còn hiệu lực lúc build, nên mảng này để trống).
type PortfolioSkillRef {
  skillId    String   @db.ObjectId
  code       String
  name       String
  icon       String
  unlockedAt DateTime
}

/// Số liệu hệ thống ghi nhận chụp lúc thêm/làm mới/Publish. `…X10` = giá trị × 10 làm tròn; `null` = chưa có dữ liệu/không được phép công khai.
type PortfolioSnapshot {
  tasksDone          Int
  storyPointsX10     Int
  onTimeRatePct      Int?
  /// Điểm đóng góp (thang 0–100, công thức D-09) — CHỈ lưu khi chủ hồ sơ bật `career.visibility.showContribution` lúc chụp.
  contributionPctX10 Int?
  /// % chiếm khối lượng của cả nhóm — cùng điều kiện với `contributionPctX10`.
  contributionShareX10 Int?
  peerReviewAvgX10   Int?
  filesUploaded      Int
  teammatesCount     Int
  /// Tên (hiện tại) CHỈ của đồng đội đã bật `appearInOthersPortfolios`; rỗng khi `showTeammates = false`. Tối đa 10.
  namedTeammates     String[]
  skillBadges        PortfolioSkillRef[]
}

model PortfolioProject {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  portfolioId   String            @db.ObjectId
  userId        String            @db.ObjectId
  workspaceId   String            @db.ObjectId
  /// Mặc định = tên nhóm nhưng người dùng sửa được; KHÔNG bao giờ lấy tiêu đề task/tên kênh/nội dung tài liệu.
  title         String
  summary       String?
  role          String?
  periodFrom    DateTime?
  periodTo      DateTime?
  highlights    String[]
  /// Ảnh bìa (asset scope AVATAR của chính chủ, `AssetLink PORTFOLIO`, targetId = id dự án).
  coverAssetId  String?           @db.ObjectId
  visible       Boolean           @default(true)
  order         Int               @default(0)
  showTeammates Boolean           @default(false)
  snapshot      PortfolioSnapshot
  snapshotAt    DateTime
  /// CAS của sửa nội dung do người dùng viết (`expectedVersion`); chụp lại snapshot KHÔNG tăng.
  version       Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([portfolioId, workspaceId])
  @@index([portfolioId, order])
  @@index([userId])
  @@index([workspaceId])
}

enum PortfolioBuildStatus {
  QUEUED
  BUILDING
  READY
  FAILED
}

enum PortfolioBuildTrigger {
  PUBLISH
  SKILL_REVOKED
  RESTORE
}

/// Lịch sử build (idempotent theo `[portfolioId, buildVersion]`). `storageKey` = "<prefix><portfolioId>/b<n>/"; `files` = tên object trong thư mục đó
/// (gồm `index.html`) để job dọn xoá đúng từng object (storage không có thao tác liệt kê theo tiền tố).
model PortfolioBuild {
  id               String                @id @default(auto()) @map("_id") @db.ObjectId
  portfolioId      String                @db.ObjectId
  buildVersion     Int
  status           PortfolioBuildStatus  @default(QUEUED)
  trigger          PortfolioBuildTrigger
  /// `Portfolio.version` lúc yêu cầu Publish — client so với `version` hiện tại để biết "có thay đổi chưa công khai".
  portfolioVersion Int
  storageKey       String?
  files            String[]
  sizeBytes        Int?
  error            String?
  createdBy        String?               @db.ObjectId
  createdAt        DateTime              @default(now())
  /// Lúc job nhận build (lease của `portfolio.stale-build-reaper`).
  startedAt        DateTime?
  finishedAt       DateTime?
  purgedAt         DateTime?

  @@unique([portfolioId, buildVersion])
  @@index([status, createdAt])
}

/// Slug cũ giữ 30 ngày: `redirectTo` = slugKey mới (301) hoặc null (tài khoản bị ẩn danh hoá/xoá hồ sơ → 404 nhưng không ai khác lấy được).
model PortfolioSlugReservation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slugKey     String   @unique
  portfolioId String   @db.ObjectId
  redirectTo  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([portfolioId])
}

// ── p6-02 whiteboards ── Bảng trắng cộng tác (module `whiteboards`): cùng cơ chế Yjs + `collab/` với `documents` (documentName `wb:<id>`). BE là NGUỒN DUY NHẤT của `yjsState`
// (collab chỉ tải/lưu qua `/api/internal/whiteboards/:id/state`). Cấu trúc Y.Doc: `elements` Y.Map<id, Y.Map>, `order` Y.Array<id>, `meta` Y.Map — xem `contracts/whiteboard-elements.schema.json`.
// Mongo giới hạn 16 MB/document → `LIMITS.whiteboard.stateMaxBytes` 8 MiB (state + metadata còn dư chỗ). Cần `npm run db:push` (model + giá trị enum AssetScope/AssetLinkTarget `WHITEBOARD`).
enum WhiteboardVisibility {
  WORKSPACE
  PRIVATE
}

enum WhiteboardStatus {
  ACTIVE
  ARCHIVED
}

model Whiteboard {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId      String               @db.ObjectId
  name             String
  normalizedName   String
  visibility       WhiteboardVisibility @default(WORKSPACE)
  status           WhiteboardStatus     @default(ACTIVE)
  /// Yjs update đầy đủ (Y.encodeStateAsUpdate); `null` = chưa ai vẽ.
  yjsState         Bytes?
  /// Tăng mỗi lần ghi state (collab lưu / khôi phục snapshot) — base version để BE hợp nhất khi collab lưu chậm.
  yjsVersion       Int                  @default(0)
  /// Số phần tử (`elements.size`) BE đếm từ Yjs mỗi lần nhận state — danh sách hiển thị mà không phải tải state; trần `LIMITS.whiteboard.elementsMax`.
  elementCount     Int                  @default(0)
  /// Ảnh thu nhỏ do client chụp canvas (asset scope WHITEBOARD, `AssetLink WHITEBOARD`); danh sách ký URL thumbnail của asset này.
  thumbnailAssetId String?              @db.ObjectId
  lastEditedBy     String?              @db.ObjectId
  lastEditedAt     DateTime?
  createdBy        String               @db.ObjectId
  /// Phiên bản OPTIMISTIC của METADATA (đổi tên/visibility/thumbnail/lưu trữ/khôi phục snapshot) — khác `yjsVersion` (nội dung).
  version          Int                  @default(1)
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([workspaceId, status, updatedAt])
  @@index([status, lastEditedAt])
}

enum WhiteboardCollaboratorRole {
  EDITOR
  VIEWER
}

/// Người được mời vào bảng (bắt buộc với bảng PRIVATE; với WORKSPACE chỉ cần cho khách GUEST). Người tạo KHÔNG có dòng ở đây.
model WhiteboardCollaborator {
  id           String                     @id @default(auto()) @map("_id") @db.ObjectId
  whiteboardId String                     @db.ObjectId
  userId       String                     @db.ObjectId
  role         WhiteboardCollaboratorRole @default(EDITOR)
  addedBy      String                     @db.ObjectId
  createdAt    DateTime                   @default(now())

  @@unique([whiteboardId, userId])
  @@index([userId])
}

enum WhiteboardSnapshotKind {
  AUTO
  MANUAL
  PRE_RESTORE
}

/// Bản chụp state Yjs để xem/khôi phục: AUTO (cron mỗi giờ nếu có thay đổi), MANUAL (người dùng), PRE_RESTORE (tự tạo trước khi khôi phục).
model WhiteboardSnapshot {
  id           String                 @id @default(auto()) @map("_id") @db.ObjectId
  whiteboardId String                 @db.ObjectId
  kind         WhiteboardSnapshotKind
  label        String?
  yjsState     Bytes
  elementCount Int
  createdBy    String?                @db.ObjectId
  at           DateTime               @default(now())

  @@index([whiteboardId, at])
  @@index([whiteboardId, kind, at])
}

// ── p7-02 coins ── Kinh tế ẢO (module `coins`): ví xu mỗi người + sổ cái bất biến + cửa hàng vật phẩm hồ sơ + nhiệm vụ ngày.
// ⛔ Xu KHÔNG phải tiền thật: không nạp bằng tiền, không quy đổi ra tiền, không liên quan `WorkspaceExpense/Settlement` của ví chi tiêu nhóm (p6-04, module `wallet`).
// Mọi thay đổi `CoinWallet.balance` đi qua `CoinLedgerService` — MỘT transaction gồm cập nhật CÓ ĐIỀU KIỆN (CAS, số dư không âm, không vượt trần) + một dòng
// `CoinTransaction` (unique `(type, refType, refId, userId)` chống cộng/trừ hai lần). Chợ tài liệu (`MarketplaceListing/Purchase`, P1) CHƯA có model ở đây.
enum CoinTxType {
  EARN_EVENT
  EARN_QUEST
  SPEND_SHOP
  /// P1 (chợ tài liệu) — đã có để `CoinLedgerService.transfer` dùng; P0 KHÔNG có endpoint nào phát dòng này.
  SPEND_MARKETPLACE
  EARN_SALE
  BURN_FEE
  REFUND
  ADJUST_ADMIN
}

enum ShopItemKind {
  AVATAR_FRAME
  PROFILE_THEME
  EMOJI_PACK
}

/// Ví xu của MỘT người (tạo lười ở lần nhận/tiêu đầu tiên). `balance` là CACHE của Σ `CoinTransaction.amount` — job đối soát so lệch rồi CẢNH BÁO, không tự sửa.
/// KHÔNG bao giờ ghi trực tiếp: chỉ `CoinWalletRepository.applyDelta` (điều kiện `balance` trong khoảng cho phép) dưới `CoinLedgerService`.
model CoinWallet {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  /// ≥ 0 (điều kiện CAS) và ≤ `LIMITS.coins.balanceMax` (nhỏ hơn Int32 để cộng không tràn).
  balance        Int      @default(0)
  /// Tổng đã nhận (các loại EARN), tổng đã tiêu (các loại SPEND và BURN_FEE) — điều chỉnh của admin KHÔNG tính vào hai số này.
  lifetimeEarned Int      @default(0)
  lifetimeSpent  Int      @default(0)
  /// Tăng MỖI lần đổi số dư (theo dõi/đối soát; không dùng làm điều kiện CAS — điều kiện là `balance`).
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Sổ cái APPEND-ONLY: không sửa, không xoá. `amount` có dấu (+ nhận, − tiêu), `balanceAfter` = số dư ngay sau dòng này (đọc trong CÙNG transaction).
model CoinTransaction {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  userId         String     @db.ObjectId
  amount         Int
  type           CoinTxType
  /// XP_EVENT | QUEST | SHOP_ITEM | ADMIN | (P1) PURCHASE | LISTING
  refType        String
  /// XP_EVENT: `<sourceType>:<sourceId>`; QUEST: `<questId>:<YYYY-MM-DD>`; SHOP_ITEM: itemId; ADMIN: Idempotency-Key của lần điều chỉnh.
  refId          String
  balanceAfter   Int
  counterpartyId String?    @db.ObjectId
  /// Lý do (admin điều chỉnh) — KHÔNG PII, tối đa 500 ký tự.
  note           String?
  /// Admin thực hiện (ADJUST_ADMIN); `null` với dòng do hệ thống/người dùng tự tạo.
  actorId        String?    @db.ObjectId
  at             DateTime   @default(now())

  @@unique([type, refType, refId, userId])
  @@index([userId, at])
  @@index([type, at])
}

/// Nhật ký XỬ LÝ sự kiện `xp.awarded` (id = `XpEvent.dedupeKey` `<sourceType>:<sourceId>:<userId>`): mỏ neo idempotent CHUNG cho thưởng xu VÀ tiến độ nhiệm vụ
/// (một sự kiện bị retry/giao lại không cộng hai lần), đồng thời là nguồn của TRẦN NGÀY (Σ `coins` theo `userId + localDate`, trong cùng transaction với dòng ledger).
model CoinEarnEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  dedupeKey  String   @unique
  userId     String   @db.ObjectId
  sourceType String
  sourceId   String
  /// "YYYY-MM-DD" theo múi giờ người dùng tại thời điểm sự kiện.
  localDate  String
  /// Xu ĐÃ thưởng (0 = chỉ tính tiến độ nhiệm vụ, hoặc vượt trần ngày).
  coins      Int
  capped     Boolean  @default(false)
  at         DateTime @default(now())

  @@index([userId, localDate])
}

/// Luật thưởng xu theo nguồn XP (`sourceType` = `XpSourceType`; ADMIN_ADJUST bị loại cứng — điều chỉnh XP của admin không đẻ ra xu). Admin chỉnh (lý do + audit + CAS `version`);
/// có hiệu lực ≤ 60 s, KHÔNG hồi tố.
model CoinRule {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  sourceType String   @unique
  coins      Int
  /// null = chỉ chịu trần chung `LIMITS.coins.dailyEarnCap`.
  dailyCap   Int?
  isActive   Boolean  @default(true)
  version    Int      @default(1)
  updatedBy  String?  @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Nhiệm vụ ngày (cấu hình). `metric` ∈ whitelist đếm từ `xp.awarded` (tasksDone, tasksOnTime, quizzesTaken, quizzesPassed, srReviewDays, reviewsGiven, setsPublished, pomodoroCycles).
model CoinQuest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  title       String
  description String
  metric      String
  target      Int
  coins       Int
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  version     Int      @default(1)
  updatedBy   String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, metric])
}

/// Tiến độ nhiệm vụ của MỘT người trong MỘT ngày (`date` theo `User.timezone`). Tạo trước NGOÀI transaction (unique) rồi `$inc` trong transaction thưởng.
/// `claimedAt` đặt bằng `updateMany` có điều kiện (`progress ≥ target`, `claimedAt = null`) — nhận thưởng đúng một lần.
model UserQuestProgress {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  questId   String    @db.ObjectId
  date      String
  progress  Int       @default(0)
  claimedAt DateTime?
  updatedAt DateTime  @updatedAt

  @@unique([userId, questId, date])
  @@index([userId, date])
}

/// Vật phẩm hồ sơ bán bằng xu. `data` = token hiển thị theo `kind` (khung avatar/theme/danh sách emoji) — schema Zod theo kind ở DTO admin.
model ShopItem {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  code          String       @unique
  name          String
  kind          ShopItemKind
  price         Int
  assetId       String?      @db.ObjectId
  data          Json?
  isActive      Boolean      @default(true)
  availableFrom DateTime?
  availableTo   DateTime?
  version       Int          @default(1)
  updatedBy     String?      @db.ObjectId
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isActive, kind])
}

/// Kho đồ: một dòng mỗi (người, vật phẩm) — mua lại bị chặn bởi unique (và bởi ledger SPEND_SHOP). `equipped` tối đa MỘT dòng mỗi `(userId, kind)` (service tháo cùng loại trong transaction).
model UserInventory {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  userId     String       @db.ObjectId
  itemId     String       @db.ObjectId
  kind       ShopItemKind
  equipped   Boolean      @default(false)
  acquiredAt DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, itemId])
  @@index([userId, kind, equipped])
  @@index([itemId])
}

// ── p7-02 marketplace (P1) ── Chợ tài liệu: bán StudySet công khai / Resource cá nhân cho thành viên khác lấy Coins nội bộ (KHÔNG phải tiền thật — dùng lại `CoinLedgerService.transfer`, loại `SPEND_MARKETPLACE/EARN_SALE/BURN_FEE/REFUND`).
enum ListingContentType {
  STUDY_SET
  RESOURCE
}

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  HIDDEN
  WITHDRAWN
}

/// Tin niêm yết. Một nội dung gốc chỉ niêm yết được MỘT lần đang hoạt động (`@@unique([contentType, contentId])` — xoá/rút tin rồi mới niêm yết lại). `status` khởi tạo `PENDING_REVIEW` khi người bán mới/dưới `sellerMinLevel`, ngược lại `ACTIVE` ngay.
/// `normalizedTitle` phục vụ tìm kiếm thô (cùng quy ước `Workspace.normalizedName`). `hiddenReason` chỉ set khi admin ẩn thủ công hoặc tự động do vượt `LIMITS.marketplace.autoHideReports`.
model MarketplaceListing {
  id              String             @id @default(auto()) @map("_id") @db.ObjectId
  sellerId        String             @db.ObjectId
  contentType     ListingContentType
  contentId       String             @db.ObjectId
  title           String
  normalizedTitle String
  description     String?
  tags            String[]
  price           Int
  status          ListingStatus      @default(PENDING_REVIEW)
  /// Số lượt mua thành công — chỉ tăng, KHÔNG giảm khi hoàn tiền (hoàn tiền không "huỷ" một lượt bán đã xảy ra).
  sales           Int                @default(0)
  reportCount     Int                @default(0)
  hiddenReason    String?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([contentType, contentId])
  @@index([status, createdAt])
  @@index([sellerId])
}

/// Lượt mua MỘT tin — mua lại bị chặn bởi `@@unique([listingId, buyerId])`. `fee` = phần nền tảng giữ lại (`floor(price × feePercent / 100)`), người bán nhận `price − fee`.
/// `accessRef` = id bản sao StudySet của người mua (STUDY_SET) / id bản ghi cấp quyền cho RESOURCE (service `marketplace.grant-access` của Wave 2 quyết định cơ chế — be.md gợi ý `AssetLink` targetType riêng, CHƯA khai enum ở đây), set sau khi job chạy xong (`null` = đang chờ cấp quyền).
model MarketplacePurchase {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  listingId  String    @db.ObjectId
  buyerId    String    @db.ObjectId
  price      Int
  fee        Int
  accessRef  String?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([listingId, buyerId])
  @@index([buyerId, createdAt])
}

// ── p7-03 burnout radar ── Sức khoẻ học tập (module `burnout`): DỮ LIỆU SỨC KHOẺ TINH THẦN nhạy cảm — mặc định TẮT, chỉ người tự BẬT (opt-in) mới bị thu thập, chỉ chính họ thấy chi tiết. Admin
// KHÔNG bao giờ đọc các collection này theo người (chỉ đếm gộp ẩn danh ≥ 20 người). Tắt/xoá dữ liệu/ẩn danh hoá tài khoản ⇒ xoá sạch `WellbeingDaily` + `BurnoutAssessment` của người đó. KHÔNG có nội dung tin/thẻ/tên:
// chỉ "khe 15 phút nào có hoạt động" tổng hợp thành số phút/số sự kiện theo ngày. Chia sẻ mức với trưởng nhóm (`WellbeingShare`, P1) CHƯA có mô hình.
enum WellbeingLevel {
  LOW
  MEDIUM
  HIGH
}

/// Cài đặt theo dõi của MỘT người (tạo lười khi bật lần đầu — chưa có dòng = TẮT). Đang bật ⇔ `optedInAt ≠ null` và `optedOutAt = null`; tắt đặt `optedInAt = null`.
model WellbeingSetting {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @unique @db.ObjectId
  optedInAt      DateTime?
  optedOutAt     DateTime?
  alertsEnabled  Boolean   @default(true)
  /// `{ workMinutes, breakMinutes }` — giờ làm/nghỉ mong muốn (dùng cho nút nghỉ ở P1).
  preferredBreak Json?
  /// Mốc cảnh báo gần nhất — chiếm NGUYÊN TỬ bằng `updateMany` có điều kiện (hai job chạy trùng chỉ một cảnh báo).
  lastAlertAt    DateTime?
  /// "Nhắc lại sau": không cảnh báo tới mốc này.
  snoozedUntil   DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([optedInAt])
}

/// Chỉ số MỘT ngày wellbeing của người đã bật theo dõi. `date` = ngày wellbeing `YYYY-MM-DD` theo múi giờ CỦA NGƯỜI DÙNG lúc tổng hợp — ngày mới bắt đầu 05:00 (hoạt động 00:00–05:00 thuộc ngày hôm trước).
/// Giữ `LIMITS.wellbeing.retentionDays` (90 ngày, cron dọn theo `createdAt`).
model WellbeingDaily {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String   @db.ObjectId
  date                     String
  timezone                 String
  activeMinutes            Int
  longestContinuousMinutes Int
  lateNightMinutes         Int
  eventsCount              Int
  lateNightEvents          Int
  createdAt                DateTime @default(now())

  @@unique([userId, date])
  @@index([createdAt])
}

/// Điểm rủi ro theo ngày wellbeing + nhân tố `[{ ruleId, label, metric, aggregate, days, value, threshold, points }]` + phiên bản bộ luật lúc chấm (`ruleVersion`). `alerted`/`alertedAt` = đã cảnh báo cho đánh giá này;
/// `ackAction` = `DISMISS` ("Đã hiểu") | `SNOOZE` ("Nhắc lại sau"). Giữ như `WellbeingDaily` (90 ngày).
model BurnoutAssessment {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  userId      String         @db.ObjectId
  date        String
  riskScore   Int
  level       WellbeingLevel
  factors     Json
  ruleVersion Int
  alerted     Boolean        @default(false)
  alertedAt   DateTime?
  ackAction   String?
  ackAt       DateTime?
  createdAt   DateTime       @default(now())

  @@unique([userId, date])
  @@index([createdAt])
  @@index([alertedAt])
  @@index([date])
}

/// Chia sẻ mức (P1) — người opt-in TỰ NGUYỆN chọn 1+ nhóm để trưởng nhóm thấy `level` (LOW/MEDIUM/HIGH) mới nhất của mình qua `GET /workspaces/:id/wellbeing/indicators`.
/// KHÔNG chia sẻ `riskScore`/`factors`/số phút — chỉ mức. Yêu cầu còn là thành viên ACTIVE của `workspaceId` (kiểm lại lúc đọc, không chỉ lúc tạo). Xoá theo opt-out purge cùng `WellbeingDaily`/`BurnoutAssessment`.
model WellbeingShare {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  workspaceId String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ── p7-05 plagiarism ── Quét trùng lặp NỘI BỘ workspace (k-gram + winnowing tự viết) — AI tạm dừng (D-13), KHÔNG gọi mô hình/API bên ngoài, KHÔNG so với nguồn ngoài Internet.
// Không import module `resources`: đọc tên/đuôi/`assetId`/`deletedAt` của `Resource` qua repository chỉ đọc (giống `admin-media-ops` p2-07); quyền qua `PermissionService` (resolver WORKSPACE + `resource.view`).
// Hash winnowing là int32 CÓ DẤU (khác kế hoạch — Prisma `Int` không nhận uint32; xem `be/src/modules/plagiarism/lib/constants.ts`).
enum FingerprintKind {
  TEXT
  CODE
}

enum FingerprintStatus {
  PENDING
  READY
  NO_TEXT
  UNSUPPORTED
  TOO_LARGE
  FAILED
}

enum PlagiarismScanMode {
  WITHIN_SELECTION
  WORKSPACE
}

enum PlagiarismScanStatus {
  QUEUED
  INDEXING
  SCANNING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum PlagiarismLevel {
  LOW
  MEDIUM
  HIGH
}

enum PlagiarismResultStatus {
  OK
  SKIPPED
}

/// Khoảng trùng — vị trí tính theo cả token (chỉ số) và ký tự/dòng (hiển thị); `endToken`/`endChar`/`lineEnd` là chỉ số SAU token/ký tự/dòng cuối cùng (exclusive), khớp quy ước `span-range.ts`.
type SpanRange {
  startToken Int
  endToken   Int
  startChar  Int
  endChar    Int
  lineStart  Int
  lineEnd    Int
}

/// Một nguồn trùng trong `PlagiarismResult.matchedSources` — `nameSnapshot` chụp tên Resource lúc quét (tên có thể đổi/xoá sau đó); `similarity` = containment(target ← source), 0..100.
type MatchedSource {
  resourceId   String @db.ObjectId
  nameSnapshot String
  similarity   Int
}

/// Chỉ mục fingerprint của MỘT Resource (unique theo `resourceId` — bản mới thay bản cũ hoàn toàn khi tệp đổi phiên bản). `hashes` = tập hash winnowing DUY NHẤT đã sắp xếp, cắt còn ≤
/// `LIMITS.plagiarism.fingerprintsPerDocMax` (giữ hash nhỏ nhất — tất định). `derivedKey` trỏ tệp dẫn xuất nén gzip (văn bản chuẩn hoá + bản đồ vị trí + postings) trên storage, KHÔNG lưu trong Mongo.
/// `resourceDeleted` đổi theo vòng đời Resource (thùng rác) để loại khỏi so khớp mà KHÔNG xoá fingerprint (khôi phục lại dùng được ngay).
model DocumentFingerprint {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String            @db.ObjectId
  resourceId      String            @unique @db.ObjectId
  /// Phiên bản Resource lúc lập chỉ mục — job CAS khớp version mới xử lý; bản mới hơn tới trong lúc job chạy → job bỏ qua (job kế tiếp xử lý bản mới).
  resourceVersion Int
  assetId         String            @db.ObjectId
  kind            FingerprintKind?
  /// Chỉ CODE: "c-like" | "python" | "sql" | "markup".
  language        String?
  status          FingerprintStatus @default(PENDING)
  /// `PLAGIARISM_ALGO_VERSION` lúc lập chỉ mục — đổi hằng số này (thay thuật toán) → fingerprint cũ cần `plagiarism.reindex`.
  algoVersion     Int
  tokenCount      Int               @default(0)
  hashCount       Int               @default(0)
  hashes          Int[]
  /// Văn bản bị cắt do vượt `LIMITS.plagiarism.charsMax`.
  truncated       Boolean           @default(false)
  /// `derived/plagiarism/<workspaceId>/<resourceId>/v<resourceVersion>-a<algoVersion>.json.gz`.
  derivedKey      String?
  errorCode       String?
  resourceDeleted Boolean           @default(false)
  indexedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // multikey — chỉ số đảo ngược tra "tài liệu nào chứa hash X" theo workspace + loại.
  @@index([workspaceId, kind, hashes])
  @@index([workspaceId, status])
  @@index([algoVersion, status])
}

/// Một lượt quét — snapshot cấu hình lúc tạo (`configSnapshot`, không đổi theo admin sửa `SystemConfig` sau đó) để kết quả nhất quán trong suốt vòng đời lượt quét.
/// `targetResourceIds` = đích cần chấm điểm; `excludeResourceIds`/`excludeFolderIds` = loại khỏi tập NGUỒN so khớp (không loại khỏi đích). `expiresAt` = hạn lưu báo cáo (`LIMITS.plagiarism.reportRetentionDays`).
model PlagiarismScan {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String               @db.ObjectId
  requestedBy        String               @db.ObjectId
  mode               PlagiarismScanMode
  targetResourceIds  String[]             @db.ObjectId
  excludeResourceIds String[]             @db.ObjectId
  excludeFolderIds   String[]             @db.ObjectId
  note               String?
  status             PlagiarismScanStatus @default(QUEUED)
  /// 0..100 — cập nhật throttle tối đa 1 lần/2 giây trong lúc `SCANNING`.
  progress           Int                  @default(0)
  algoVersion        Int
  /// Ngưỡng/k/window/minSectionTokens/boilerplate… tại thời điểm tạo — xem `plagiarism-config.service.snapshot()`.
  configSnapshot     Json
  /// INDEX_TIMEOUT | ALL_TARGETS_SKIPPED | INTERNAL.
  failureCode        String?
  startedAt          DateTime?
  finishedAt         DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?              @db.ObjectId
  expiresAt          DateTime
  deletedAt          DateTime?
  version            Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([workspaceId, deletedAt, createdAt])
  @@index([workspaceId, status])
  @@index([status, updatedAt])
  @@index([expiresAt])
}

/// Kết quả MỘT tệp đích trong MỘT lượt quét (unique theo `(scanId, targetResourceId)`). `targetName` chụp tên Resource lúc quét. `matchedSources` ≤ 10, sắp giảm dần theo `similarity`.
/// `skipReason` chỉ set khi `status = SKIPPED`: NO_TEXT | UNSUPPORTED | TOO_LARGE | FAILED | DELETED.
model PlagiarismResult {
  id               String                 @id @default(auto()) @map("_id") @db.ObjectId
  scanId           String                 @db.ObjectId
  targetResourceId String                 @db.ObjectId
  targetName       String
  kind             FingerprintKind?
  status           PlagiarismResultStatus
  skipReason       String?
  score            Int                    @default(0)
  level            PlagiarismLevel?
  matchedSources   MatchedSource[]
  sectionCount     Int                    @default(0)
  createdAt        DateTime               @default(now())

  @@unique([scanId, targetResourceId])
}

/// Một khoảng trùng cụ thể giữa đích và MỘT nguồn, đã gộp từ các cặp vị trí trùng hash liền kề (`section-merger.ts`). `order` = thứ tự hiển thị trong đích (unique theo `(scanId, targetResourceId, order)`).
/// `similarity` = % fingerprint khớp trong khoảng (không phải điểm tổng của `PlagiarismResult.score`).
model PlagiarismSection {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  scanId           String    @db.ObjectId
  targetResourceId String    @db.ObjectId
  sourceResourceId String    @db.ObjectId
  order            Int
  target           SpanRange
  source           SpanRange
  similarity       Int
  matchedHashes    Int

  @@unique([scanId, targetResourceId, order])
  @@index([scanId, sourceResourceId])
}
