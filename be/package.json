{
  "name": "super-app-be",
  "version": "1.0.0",
  "description": "Super App Backend API — Express + TypeScript + MongoDB (Prisma) + Cloudinary base",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "deploy": "railway up --service api --ci && railway up --service worker --ci",
    "deploy:api": "railway up --service api --ci",
    "deploy:worker": "railway up --service worker --ci",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "worker": "node dist/worker.js",
    "dev:worker": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:reset": "prisma db push --force-reset",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --skip-generate",
    "db:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "db:backfill-normalized-name": "ts-node -r tsconfig-paths/register scripts/backfill-normalized-name.ts",
    "db:migrate-asset-links": "ts-node -r tsconfig-paths/register scripts/migrate-asset-links.ts",
    "db:backfill-grant-subject-key": "ts-node -r tsconfig-paths/register scripts/backfill-channel-grant-subject-key.ts",
    "db:backfill-normalize-email": "ts-node -r tsconfig-paths/register scripts/backfill-normalize-email.ts",
    "db:backfill-workspace-images": "ts-node -r tsconfig-paths/register scripts/backfill-workspace-images.ts",
    "db:seed:templates": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-workspace-templates.ts",
    "db:seed:demo-workspace": "ts-node -r tsconfig-paths/register scripts/seed-demo-workspace.ts",
    "db:seed:rich-demo": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-rich-demo.ts",
    "db:seed:rich-media": "ts-node --transpile-only -r tsconfig-paths/register scripts/seed-rich-media.ts",
    "db:ensure-indexes": "ts-node -r tsconfig-paths/register scripts/ensure-indexes.ts",
    "roadmap:import:fullstack": "ts-node --transpile-only -r tsconfig-paths/register scripts/import-roadmap-fullstack.ts",
    "roadmap:import:english": "ts-node --transpile-only -r tsconfig-paths/register scripts/import-roadmap-english.ts",
    "gen:openapi": "ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "gen:error-codes": "ts-node -r tsconfig-paths/register scripts/export-error-codes.ts",
    "contracts:export": "npm run gen:openapi && npm run gen:error-codes",
    "metrics:check": "curl -s -H \"Authorization: Bearer $METRICS_TOKEN\" localhost:3000/metrics | head",
    "gen:module": "ts-node -r tsconfig-paths/register scripts/generate-module.ts",
    "gen:middleware": "ts-node -r tsconfig-paths/register scripts/generate-middleware.ts",
    "gen:service": "ts-node -r tsconfig-paths/register scripts/generate-service.ts",
    "gen:exception": "ts-node -r tsconfig-paths/register scripts/generate-exception.ts",
    "setup": "ts-node -r tsconfig-paths/register scripts/setup-project.ts",
    "clean": "rimraf dist logs",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "prisma",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.504.0",
    "@prisma/client": "^5.8.0",
    "@sentry/node": "^10.75.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.5",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "eta": "^4.6.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "file-type": "^16.5.4",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.19.1",
    "mammoth": "^1.13.0",
    "marked": "^12.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.15.0",
    "nodemailer": "^9.1.1",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.6.10",
    "sharp": "^0.35.4",
    "socket.io": "^4.6.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "yjs": "^13.6.33",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "fast-check": "^4.10.1",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.2.4",
    "prisma": "^5.8.0",
    "rimraf": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "bullmq": {
      "redis": "$redis"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
