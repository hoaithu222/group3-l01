# ═══════════════════════════════════════════════════════════════════════════════
# Super App Backend — biến môi trường
#
# Chép file này thành `.env` rồi điền giá trị thật: cp .env.example .env
# Ký hiệu phase: [P0] nền tảng · [P1]..[P6] theo development-plan.md · [⏸] tạm dừng (AI, D-13)
# ═══════════════════════════════════════════════════════════════════════════════

# ═══ App ═══════════════════════════════════════════════════════════════════ [P0]
APP_NAME=Super App API
APP_VERSION=1.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# true (chỉ có tác dụng khi NODE_ENV=production): log JSON ra stdout, không ghi logs/*.log — BẮT BUỘC trên Railway (chỉ thu log từ stdout)
LOG_STDOUT=false
# Vai trò tiến trình: api | worker | all (dev mặc định all — worker chạy in-process)
PROCESS_ROLE=all
# Origin được phép (CSV). Dev bỏ trống → whitelist mặc định: 8081, 19006, 5173–5190 (localhost và 127.0.0.1)
# Prod (D-14): https://admin.superapp.vcijsc.com,https://superapp.vcijsc.com
ALLOWED_ORIGINS=
# Base URL công khai của API (webhook, link tải) — dev: http://localhost:3000
# ⛔ BẮT BUỘC đặt giá trị thật trong production (server không khởi động nếu thiếu, từ 28/09/2026)
PUBLIC_API_URL=http://localhost:3000
# Base URL admin web — link email reset/verify
# ⛔ BẮT BUỘC đặt giá trị thật trong production (server không khởi động nếu thiếu, từ 28/09/2026)
FRONTEND_URL=http://localhost:5173
# (p2-04) Gốc URL web cho link /m/<mã họp> trong email lịch họp (mặc định = FRONTEND_URL); địa chỉ ORGANIZER của .ics (mặc định SMTP_FROM)
# PUBLIC_WEB_BASE_URL=https://superapp.vcijsc.com
# MAIL_ICS_ORGANIZER_EMAIL=no-reply@superapp.vcijsc.com
# Gốc dựng URL lời mời (/invite/:token, p1-02) — dev: Expo dev server
# ⛔ BẮT BUỘC đặt giá trị thật trong production (server không khởi động nếu thiếu, từ 28/09/2026)
PUBLIC_APP_LINK_BASE=http://localhost:8081
SWAGGER_ENABLED=true
# Cờ phân hệ: "a=true,b=false" — khoá lạ bị cảnh báo. Mặc định tất cả false.
FEATURE_FLAGS=

# ═══ JWT ═══════════════════════════════════════════════════════════════════ [P0]
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d
# Khoá AES-256-GCM (32 byte hex) cho token tích hợp, tài khoản ngân hàng, API key đối tác
ENCRYPTION_KEY=

# ═══ Database — MongoDB (Atlas hoặc replica set local) ═════════════════════ [P0]
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/superapp?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/superapp?replicaSet=rs0  (docker compose --profile mongo)

# ═══ Redis ═════════════════════════════════════════════════════════════════ [P0]
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=superapp:

# ═══ Queue (BullMQ) ════════════════════════════════════════════════════════ [P0]
QUEUE_PREFIX=superapp
WORKER_CONCURRENCY_DEFAULT=5
WORKER_CONCURRENCY_NOTIFICATIONS=20
WORKER_CONCURRENCY_MEDIA=2
WORKER_CONCURRENCY_CALLS=10
WORKER_CONCURRENCY_PUSH=10
# Chờ tối đa (ms) cho job đang chạy hoàn tất khi graceful shutdown
WORKER_SHUTDOWN_GRACE_MS=30000
CRON_TZ=Asia/Ho_Chi_Minh
# Outbox relay (p0-04) — mỗi lần claim tối đa bao nhiêu event, poll fallback mỗi bao lâu
OUTBOX_RELAY_BATCH=50
OUTBOX_POLL_MS=1000
# System config / feature flags (p0-07) — TTL cache bộ nhớ (ms) cho
# RuntimeConfigService + cửa sổ gộp (ms) khi phát `config:updated`
SYSTEM_CONFIG_CACHE_MS=5000
CONFIG_BROADCAST_DEBOUNCE_MS=2000
# Realtime (p0-03) — redis | memory. Production BẮT BUỘC redis (validate-runtime)
SOCKET_ADAPTER=redis
# Định danh instance trong connection registry — trống = os.hostname()
INSTANCE_ID=

# ═══ Storage & Asset (p0-05) ═══════════════════════════════════════════════ [P0]
STORAGE_TYPE=local            # local | s3 | cloudinary
UPLOAD_DIR=uploads
MAX_FILE_SIZE=100mb
SIGNED_URL_TTL_SECONDS=60
ASSET_ORPHAN_TTL_HOURS=24
# false → luôn dùng API_PUT (PUT /assets/:id/content) dù STORAGE_TYPE=s3
STORAGE_PUBLIC_UPLOAD=true
# Thư mục tạm worker dùng khi tải asset về xử lý thumbnail/duration — trống = os.tmpdir()
MEDIA_TMP_DIR=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Endpoint tuỳ chọn cho MinIO/S3-compatible (staging) — trống = AWS S3 mặc định
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═══ Mail ══════════════════════════════════════════════════════════════════ [P0]
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ═══ Quan sát ══════════════════════════════════════════════════════════════ [P0]
METRICS_ENABLED=true
METRICS_TOKEN=                # bảo vệ /metrics (Bearer) của API VÀ cổng metrics của worker; trống = chỉ localhost. Production: đặt chuỗi ngẫu nhiên ≥ 24 ký tự (khác nhau mỗi môi trường)
# [p0-11] Sentry — DSN trống = ConsoleTracker, KHÔNG nạp SDK (no-op tuyệt đối). DSN riêng cho be theo từng môi trường; DSN không phải bí mật nhưng đừng commit giá trị thật.
SENTRY_DSN=
SENTRY_ENVIRONMENT=           # staging | production | … (mặc định = NODE_ENV). ⚠ Staging chạy NODE_ENV=production nên PHẢI đặt `staging` — giá trị này cũng quyết định "production thật" (chặn dev-tools)
SENTRY_RELEASE=               # CI đặt = git sha (khớp release của source map). Railway tự suy từ RAILWAY_GIT_COMMIT_SHA nếu để trống
SENTRY_TRACES_SAMPLE_RATE=0.1 # 0..1 — staging 0.2, production 0.05
# [p0-11] Log: LOG_STDOUT=true (production) chỉ ghi JSON ra stdout (không file). LOG_FORMAT/LOG_TO_FILE là tuỳ chọn ghi đè (trống = hành vi mặc định theo NODE_ENV/LOG_STDOUT).
# LOG_FORMAT=json             # json | pretty (console/stdout)
# LOG_TO_FILE=false           # false ≡ LOG_STDOUT=true; true = vẫn ghi logs/*.log
# [p0-11] Cổng metrics RIÊNG của worker (`worker:9464/metrics`, Bearer METRICS_TOKEN; /health/live không cần token). 0 = tắt. Không publish ra ngoài host.
WORKER_METRICS_PORT=9464
# [p0-11] `POST /api/v1/dev/sentry-test` (OPS-01) — CHỈ dev/staging; bị CẤM ở production thật (validate-runtime báo lỗi). Cần quyền system-config:update.
DEV_TOOLS_ENABLED=false
# [p0-08/p0-11] Job `media.turn-probe` (5 phút) thăm dò TURN (STUN UDP + bắt tay TLS) → admin health `turn` + metric turn_probe_*. Trống = không thăm dò.
TURN_PROBE_HOST=              # vd turn.superapp.vcijsc.com (staging: turn-staging.superapp.vcijsc.com)
TURN_PROBE_TLS_PORT=443
TURN_PROBE_UDP_PORT=3478

# ═══ Push (Firebase Cloud Messaging — D-15) ═══════════════════════════════ [P4]
# Thiếu bất kỳ khoá nào bên dưới → push tắt âm thầm (log cảnh báo một lần lúc
# khởi động), không chặn app chạy. Lấy từ Firebase Console → Project settings
# → Service accounts → Generate new private key.
# CÙNG credentials này còn dùng để xác thực Firebase ID token của đăng nhập Google
# (`POST /auth/firebase-login`) — thiếu thì endpoint đó trả 503 SYS_503 (fail-closed).
# ⛔ File JSON là secret: đã có trong .gitignore (`*-firebase-adminsdk-*.json`), đừng commit.
# Local: FIREBASE_CREDENTIALS_JSON=./ten-file-service-account.json
# Railway/Docker (không có file): dán NỘI DUNG JSON vào FIREBASE_CREDENTIALS_JSON (cho CẢ api VÀ worker — worker là nơi gửi push).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=          # escape \n; hoặc dùng FIREBASE_CREDENTIALS_JSON gộp cả file
FIREBASE_CREDENTIALS_JSON=     # tuỳ chọn: đường dẫn hoặc nội dung JSON service-account, ưu tiên hơn 3 khoá trên nếu có

# ═══ APNs VoIP (p0-06) ═════════════════════════════════════════════════════ [P4]
# Thiếu bất kỳ khoá nào bên dưới → VoIP push tắt âm thầm (log cảnh báo một lần),
# call.incoming vẫn có FCM data-only cho Android — chỉ iOS mất chuông khi app bị
# tắt hẳn. Lấy `.p8` từ Apple Developer → Certificates, Identifiers & Profiles
# → Keys → tạo 1 Auth Key APNs (dùng chung cho mọi app, không riêng VoIP).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=                   # nội dung file .p8, escape \n; hoặc dùng APNS_KEY_PATH
APNS_KEY_PATH=                 # đường dẫn file .p8 trên đĩa — ưu tiên APNS_KEY_P8 nếu cả hai đều set
APNS_BUNDLE_ID=com.mancode.vungnui
APNS_USE_SANDBOX=true
# [p2-02] Namespace UUID v5 cho callUuid (apns-id/CallKit). CỐ ĐỊNH vĩnh viễn — đổi = mọi callUuid cũ mất khớp callId. Mặc định giữ giá trị đã phát hành; thường KHÔNG cần khai.
# CALL_UUID_NAMESPACE=d2f6a9b0-6e9c-4b6b-9b7a-1f9f6e6a9c1a

# ═══ Media SFU (LiveKit) ═══════════════════════════════════════════════════ [P4]
# [P0-08] LiveKit. Dev: `docker run --rm -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server --dev`
# (khoá dev mặc định devkey / secret) hoặc project LiveKit Cloud (wss://<project>.livekit.cloud).
# Webhook LiveKit → `POST {PUBLIC_API_URL}/api/v1/webhooks/livekit` (ký bằng LIVEKIT_API_SECRET) — cấu hình ở livekit.yaml.
# Khoá KHÁC NHAU mỗi môi trường (D-24); không commit khoá thật.
LIVEKIT_URL=                   # URL NỘI BỘ BE → LiveKit (vd http://livekit:7880 hoặc http://localhost:7880)
LIVEKIT_PUBLIC_URL=            # URL CLIENT kết nối (vd wss://lk.superapp.vcijsc.com); bắt buộc ở production khi bật voice/meeting
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Ghi hình (egress RoomComposite → S3 riêng tư). Thiếu → ghi hình tắt (MEDIA_001 khi bắt đầu ghi).
EGRESS_S3_BUCKET=
EGRESS_S3_REGION=
EGRESS_S3_ACCESS_KEY_ID=
EGRESS_S3_SECRET_ACCESS_KEY=
EGRESS_S3_PREFIX=recordings/
# Spike thiết bị (POST /api/v1/dev/media/spike-token): CHỈ dev/staging, cấm ở production (validate-runtime báo lỗi).
MEDIA_SPIKE_ENABLED=false
MEDIA_SPIKE_ALLOWED_EMAILS=    # email (phân tách dấu phẩy) được xin token spike ngoài người có system-config:update

# ═══ Tích hợp OAuth ════════════════════════════════════════════════════════ [P4]
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# ═══ Collab (Hocuspocus) ═══════════════════════════════════════════════════ [P5]
# URL CÔNG KHAI client kết nối WebSocket (dev: ws://localhost:4000; staging/prod: wss://superapp.vcijsc.com/collab). Chỉ cần khi bật cờ `collab`.
COLLAB_URL=ws://localhost:4000
# URL NỘI BỘ BE → collab (kick/flush/apply/health): compose `http://collab:4000`, dev `http://localhost:4000`.
COLLAB_INTERNAL_URL=http://localhost:4000
# Bí mật dùng chung với collab (`collab/.env` COLLAB_SHARED_SECRET): ≥ 32 ký tự, KHÁC JWT_SECRET, khác nhau giữa các môi trường.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLLAB_SHARED_SECRET=

# ═══ Bản đồ / O2O ══════════════════════════════════════════════════════════ [P5]
MAPBOX_TOKEN=                 # geocode phía server (tuỳ chọn)
# p6-07 Portfolio: gốc URL công khai của trang hồ sơ (BẮT BUỘC khi FEATURE_FLAGS bật `career`) + tiền tố khoá storage của object build.
# Staging/production: PUBLIC_PORTFOLIO_BASE_URL=https://superapp.vcijsc.com/p (nginx `location /p/` proxy về API — xem deploy/).
PUBLIC_PORTFOLIO_BASE_URL=http://localhost:3000/p
PORTFOLIO_STORAGE_PREFIX=portfolio/

# ═══ AI — ⏸ TẠM DỪNG (D-13). Để trống; chỉ điền khi mở lại ════════════════ [⏸]
AI_PROVIDER=anthropic
AI_PROFILE=quality
AI_MODEL_DEFAULT=claude-opus-5
AI_MODEL_LIGHT=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMBEDDINGS_PROVIDER=gemini
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768
EMBEDDINGS_TIER=free
EMBEDDINGS_RPM=
EMBEDDINGS_RPD=
EMBEDDINGS_BATCH=100
KNOWLEDGE_VECTOR=atlas
AI_MAX_INPUT_TOKENS=120000
AI_STT_PROVIDER=
AI_STT_API_KEY=

# ═══ Seed (dev only) ════════════════════════════════════════════════════════ [P0]
SEED_ADMIN_EMAIL=admin@superapp.local
SEED_ADMIN_PASSWORD=

# ═══ Test ═══════════════════════════════════════════════════════════════════ [P0]
# memory = mongodb-memory-server (mặc định CI); để trống dùng DATABASE_URL hiện có
TEST_DB=
