# ─────────────────────────────────────────────────────────────────────────────
# Super App Admin — mẫu biến môi trường PRODUCTION
#
# Mẫu để CI điền qua secret — KHÔNG commit giá trị thật (chỉ URL, không secret).
# Host: admin.superapp.vcijsc.com (D-14) — API cùng host qua nginx nên
# VITE_API_BASE_URL giữ tương đối.
# ─────────────────────────────────────────────────────────────────────────────

VITE_APP_NAME=Super App Admin
VITE_ENV=production
VITE_API_BASE_URL=/api/v1
VITE_API_TIMEOUT=30000
VITE_ENABLE_ERROR_TOAST=true
VITE_ENABLE_API_LOGGING=false
VITE_AUTH_ENABLED=true
VITE_SOCKET_PATH=/socket.io

# ── Sentry (p0-11) — CI điền, KHÔNG commit giá trị thật ───────────────────────
VITE_SENTRY_DSN=
VITE_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
