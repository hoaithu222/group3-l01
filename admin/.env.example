# ─────────────────────────────────────────────────────────────────────────────
# Super App Admin — biến môi trường
#
# Chép file này thành `.env` (hoặc `.env.local`) rồi điền giá trị thật.
# ⛔ Mọi biến có tiền tố VITE_ đều NẰM TRONG BUNDLE gửi cho trình duyệt.
#    KHÔNG đặt secret (API key, chuỗi kết nối DB, private key) ở đây.
#
# Backend đối ứng: `../be` (Express, mặc định cổng 3000, API tại /api/v1/*).
# ─────────────────────────────────────────────────────────────────────────────

# Tên hiển thị của ứng dụng
VITE_APP_NAME=Super App Admin

# Môi trường: development | staging | production
VITE_ENV=development

# Gốc API — KHÔNG kèm dấu "/" cuối.
#   Dev  : /api/v1  (same-origin, Vite proxy chuyển tiếp /api/* sang BE — xem
#          VITE_API_PROXY_TARGET). Đi same-origin để cookie HttpOnly refresh-token
#          không bị trình duyệt coi là third-party.
#   Prod : cũng nên là /api/v1 sau reverse proxy (nginx) cùng domain với admin.
#          Chỉ dùng https://api.example.com/api/v1 khi đã cấu hình cookie
#          SameSite/Domain tương ứng ở BE và thêm origin admin vào ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api/v1

# Thời gian chờ tối đa mỗi request, tính bằng mili-giây (mặc định 30000)
VITE_API_TIMEOUT=30000

# Bật toast lỗi tập trung ở response interceptor: true | false (mặc định true)
VITE_ENABLE_ERROR_TOAST=true

# Ghi log request/response ra console: true | false (mặc định false)
VITE_ENABLE_API_LOGGING=false

# Đích proxy của máy chủ phát triển cho đường /api (CHỈ dùng lúc dev).
# BE Super App chạy `npm run dev` trong ../be, cổng theo `be/.env` PORT (mặc định 3000).
VITE_API_PROXY_TARGET=http://localhost:3000

# Bật kiểm đăng nhập trên router: true | false
# ⛔ Dự án thật: luôn `true`. Chỉ đặt `false` tạm thời khi dựng giao diện mà BE
#    chưa sẵn sàng (mọi route sẽ mở cho người chưa đăng nhập).
VITE_AUTH_ENABLED=true

# Đường Socket.IO — cùng origin (proxy /socket.io → BE lúc dev). Đổi khi BE đặt path khác.
VITE_SOCKET_PATH=/socket.io

# Token Mapbox công khai (Phase 5, module o2o) — giới hạn domain trên Mapbox. Trống = ẩn bản đồ.
VITE_MAPBOX_TOKEN=

# ── Sentry (p0-11) ───────────────────────────────────────────────────────────
# DSN của project Sentry `admin` (riêng từng môi trường). TRỐNG = tắt hoàn toàn: không nạp SDK, không gửi gì.
# DSN không phải bí mật nhưng đừng commit giá trị thật; CI điền qua secret/biến môi trường của GitHub Environment.
VITE_SENTRY_DSN=

# Mã phát hành — CI đặt = git sha (khớp release của source map đã upload). Local để trống.
VITE_RELEASE=

# Tỉ lệ lấy mẫu hiệu năng (0..1). Mặc định 0 = chỉ theo dõi LỖI. Staging 0.2, production 0.05 nếu muốn bật.
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# ⛔ Các biến sau CHỈ dùng lúc BUILD ở CI (KHÔNG có tiền tố VITE_ nên không vào bundle) — plugin upload source map chỉ chạy khi có SENTRY_AUTH_TOKEN:
#   SENTRY_AUTH_TOKEN (secret CI) · SENTRY_ORG · SENTRY_PROJECT · SENTRY_URL (tuỳ chọn, Sentry tự host)
