# ─────────────────────────────────────────────────────────────────────────────
# deploy/compose/.env — biến của COMPOSE (tên miền, tag ảnh, mật khẩu Redis).
# Chép:  cp .env.example .env   rồi điền. ⛔ KHÔNG commit `.env` (deploy/.gitignore đã chặn); trên server: chmod 600.
# File này chỉ liệt kê TÊN biến + giá trị MẪU không phải bí mật. Bí mật runtime của BE nằm ở `.env.api` (xem env.api.example).
# ─────────────────────────────────────────────────────────────────────────────

# Môi trường: staging | production — khớp SENTRY_ENVIRONMENT (quyết định "production thật", chặn dev-tools).
ENV_NAME=staging

# Registry chứa ảnh (GHCR): ảnh BE `<REGISTRY>/superapp-be:<BE_TAG>`, admin `…/superapp-admin:<ADMIN_TAG>`, collab `…/superapp-collab:<COLLAB_TAG>`.
REGISTRY=ghcr.io/<org>
# Tag do CI đặt: staging = git sha; production = vX.Y.Z (semver) — ghim CỤ THỂ, không dùng `latest` (rollback = đổi tag rồi `up -d`).
BE_TAG=
ADMIN_TAG=
COLLAB_TAG=

# Tên miền (D-14). Staging: staging.superapp.vcijsc.com · admin-staging.superapp.vcijsc.com · lk-staging.… · turn-staging.…
API_DOMAIN=staging.superapp.vcijsc.com
ADMIN_DOMAIN=admin-staging.superapp.vcijsc.com
# LiveKit (chỉ staging đơn-VM cần nginx proxy — xem docker-compose.staging.override.yml). Prod: LiveKit ở VM riêng, không dùng ở đây.
LK_DOMAIN=lk-staging.superapp.vcijsc.com
TURN_DOMAIN=turn-staging.superapp.vcijsc.com

# `auth_basic` cho Swagger (/api/docs): "off" ở production; staging đặt chuỗi realm và tạo secrets/swagger.htpasswd (htpasswd -B).
SWAGGER_AUTH_BASIC=off

# Redis: mật khẩu (khác nhau mỗi môi trường) + trần bộ nhớ (BullMQ cần policy noeviction — đã đặt trong compose).
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# Universal/App links (nginx phục vụ /.well-known/*). AASA: Apple Team ID (10 ký tự). assetlinks: SHA-256 chứng chỉ ký (EAS credentials) — có thể 2 dấu vân tay
# (release + upload key), phân tách bằng dấu phẩy KHÔNG có khoảng trắng; render-config.sh tự dựng mảng JSON.
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=

# Bật service tuỳ chọn (dấu phẩy): collab — chỉ khi ảnh superapp-collab đã có (p6-01).
COMPOSE_PROFILES=
