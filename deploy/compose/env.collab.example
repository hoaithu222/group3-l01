# deploy/compose/.env.collab — bí mật của service `collab/` (chỉ khi bật profile `collab`). ⛔ KHÔNG commit; chmod 600.
# GIẢ ĐỊNH theo plan p6-01 (package `collab/` do agent khác tạo — đối chiếu lại với collab/.env.example khi package sẵn sàng).
COLLAB_SHARED_SECRET=            # CÙNG giá trị với COLLAB_SHARED_SECRET trong .env.api (≥ 32 ký tự)
STORE_DEBOUNCE_MS=2000
STORE_MAX_DEBOUNCE_MS=60000
MAX_CONNECTIONS_PER_DOC=50
LOG_LEVEL=info
SENTRY_DSN=                      # DSN project `collab` (tuỳ chọn)
