# ─────────────────────────────────────────────────────────────────────────────
# deploy/compose/.env.api — bí mật + cấu hình runtime của BE (api-1, api-2, worker dùng CHUNG file này).
# Chép:  cp env.api.example .env.api   rồi điền GIÁ TRỊ THẬT trên server, chmod 600. ⛔ KHÔNG commit (deploy/.gitignore chặn `.env.*`).
# Mọi giá trị dưới đây là MẪU/để trống. Khoá KHÁC NHAU giữa dev/staging/production (D-24). Danh mục đầy đủ + giải thích: be/.env.example.
# Compose đã tự đặt: NODE_ENV, PROCESS_ROLE, PORT, LOG_STDOUT, LOG_FORMAT, LOG_TO_FILE, REDIS_URL, REDIS_PASSWORD, SENTRY_RELEASE, SENTRY_ENVIRONMENT,
# APP_VERSION, INSTANCE_ID, WORKER_METRICS_PORT — KHÔNG lặp lại ở đây.
# ─────────────────────────────────────────────────────────────────────────────

# ── Lõi ──
DATABASE_URL=                    # mongodb+srv://… (Atlas, replica set — cần transaction). Staging/prod dùng cluster RIÊNG
JWT_SECRET=                      # ≥ 32 ký tự ngẫu nhiên
JWT_REFRESH_SECRET=              # ≥ 32 ký tự ngẫu nhiên, khác JWT_SECRET
ENCRYPTION_KEY=                  # 32 byte hex (64 ký tự): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Origin CORS (HTTPS tuyệt đối, CSV). Staging: https://admin-staging.superapp.vcijsc.com,https://staging.superapp.vcijsc.com
ALLOWED_ORIGINS=
PUBLIC_API_URL=                  # https://staging.superapp.vcijsc.com | https://superapp.vcijsc.com
PUBLIC_APP_LINK_BASE=            # cùng gốc với link mời /invite/:token (thường = PUBLIC_API_URL)
FRONTEND_URL=                    # gốc admin web (link email): https://admin-staging.superapp.vcijsc.com | https://admin.superapp.vcijsc.com
SWAGGER_ENABLED=false            # staging: true (nginx basic auth); production: false
FEATURE_FLAGS=                   # "a=true,b=false" — mặc định tất cả tắt; bật SAU nghiệm thu
SOCKET_ADAPTER=redis             # BẮT BUỘC redis ở production (2 replica)
WORKER_SHUTDOWN_GRACE_MS=30000

# ── Quan sát (p0-11) ──
METRICS_ENABLED=true
METRICS_TOKEN=                   # ≥ 24 ký tự; Prometheus đọc cùng giá trị (observability/secrets/metrics_token)
SENTRY_DSN=                      # DSN project `be` của môi trường này; trống = tắt
SENTRY_TRACES_SAMPLE_RATE=0.2    # staging 0.2 · production 0.05
DEV_TOOLS_ENABLED=false          # staging có thể true (POST /api/v1/dev/sentry-test); production PHẢI false (validate-runtime báo lỗi)
TURN_PROBE_HOST=                 # turn-staging.superapp.vcijsc.com | turn.superapp.vcijsc.com — bật job media.turn-probe

# ── Storage / Mail ──
STORAGE_TYPE=s3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Push (FCM + APNs VoIP) — xem deploy/runbooks/push-keys.md ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=            # escape \n, hoặc FIREBASE_CREDENTIALS_JSON
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=                     # nội dung .p8 (escape \n) — hoặc mount file và dùng APNS_KEY_PATH
APNS_USE_SANDBOX=false           # staging dùng build TestFlight/production → false; dev-client Xcode → true

# ── LiveKit (VM riêng) — xem deploy/livekit/README.md ──
LIVEKIT_URL=                     # URL NỘI BỘ BE → LiveKit API (IP riêng của VM media, vd http://10.0.0.5:7880; staging đơn-VM: http://host.docker.internal:7880)
LIVEKIT_PUBLIC_URL=              # wss://lk-staging.superapp.vcijsc.com | wss://lk.superapp.vcijsc.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=              # ≥ 32 ký tự; CÙNG cặp với LiveKit server (ký webhook)
EGRESS_S3_BUCKET=
EGRESS_S3_REGION=
EGRESS_S3_ACCESS_KEY_ID=
EGRESS_S3_SECRET_ACCESS_KEY=
EGRESS_S3_PREFIX=recordings/

# ── Collab (p6-01, khi bật cờ `collab`) ──
COLLAB_URL=                      # wss://superapp.vcijsc.com/collab
COLLAB_INTERNAL_URL=http://collab:4000
COLLAB_SHARED_SECRET=            # ≥ 32 ký tự, khác JWT_SECRET; CÙNG giá trị với .env.collab

# ── Portfolio / O2O (khi bật cờ `career` / `o2o`) ──
PUBLIC_PORTFOLIO_BASE_URL=       # https://superapp.vcijsc.com/p (nginx location /p/ proxy về API + proxy_cache)
PORTFOLIO_STORAGE_PREFIX=portfolio/
MAPBOX_TOKEN=

# ── Tích hợp OAuth (khi bật `integration`) ──
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
