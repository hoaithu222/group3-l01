        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(max by (mode) (call_active{job=~\"api|worker\"}))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
