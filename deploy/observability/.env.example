# ─────────────────────────────────────────────────────────────────────────────
# deploy/observability/.env — biến của compose observability + render alertmanager/secrets. Chép: cp .env.example .env ; chmod 600.
# ⛔ KHÔNG commit `.env` (deploy/.gitignore chặn). Mọi giá trị dưới đây là MẪU.
# ─────────────────────────────────────────────────────────────────────────────

# Nhãn môi trường gắn vào mọi metric/cảnh báo (staging | production).
ENV_NAME=staging

# Cùng giá trị METRICS_TOKEN trong deploy/compose/.env.api (Prometheus đọc /metrics của api + worker:9464). Render ghi ra secrets/metrics_token (chmod 600).
METRICS_TOKEN=
# Cùng giá trị REDIS_PASSWORD trong deploy/compose/.env (redis-exporter).
REDIS_PASSWORD=

# Grafana: mật khẩu admin nội bộ (dùng SSO cho nhóm dev — xem docker-compose.observability.yml) và URL gốc khi đặt sau reverse-proxy.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3001

# Alertmanager → Telegram (mọi cảnh báo) + email (critical). Bot: tạo qua @BotFather, thêm vào nhóm trực, lấy chat id (số, nhóm có dấu -).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=smtp.example.com:587
ALERT_SMTP_FROM=alerts@example.com
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# Ghim phiên bản ảnh (mặc định đã đặt trong compose; đổi khi nâng cấp):
# PROMETHEUS_TAG=v3.5.0
# ALERTMANAGER_TAG=v0.28.1
# GRAFANA_TAG=11.6.0
# LOKI_TAG=3.5.0
# PROMTAIL_TAG=3.5.0
# NODE_EXPORTER_TAG=v1.9.1
# REDIS_EXPORTER_TAG=v1.74.0
# BLACKBOX_TAG=v0.27.0
