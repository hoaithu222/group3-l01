# ─────────────────────────────────────────────────────────────────────────────
# deploy/livekit/.env — biến của compose LiveKit + template livekit.yaml/egress.yaml. Chép: cp .env.example .env ; chmod 600.
# ⛔ KHÔNG commit `.env` (deploy/.gitignore chặn). Mọi giá trị dưới đây là MẪU; khoá/mật khẩu KHÁC nhau giữa staging và production (D-24).
# ─────────────────────────────────────────────────────────────────────────────

# GHIM phiên bản cụ thể (không latest). GIÁ TRỊ MẪU — chưa kiểm: chọn bản ổn định mới nhất ở https://github.com/livekit/livekit/releases
# và https://github.com/livekit/egress/releases, chạy MED-10…13 ở staging rồi mới đưa lên production.
LIVEKIT_TAG=v1.9.0
EGRESS_TAG=v1.9.0

# Khoá API LiveKit — CÙNG cặp với BE (`LIVEKIT_API_KEY`/`LIVEKIT_API_SECRET` trong .env.api). Tạo: API key ~16 ký tự, secret ≥ 32 ký tự ngẫu nhiên.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Redis riêng của LiveKit (bind 127.0.0.1).
LK_REDIS_PORT=6380
LK_REDIS_PASSWORD=

# Tên miền (D-14). API_DOMAIN = domain của BE (URL webhook). Staging: lk-staging. / turn-staging. / staging.
API_DOMAIN=superapp.vcijsc.com
LK_DOMAIN=lk.superapp.vcijsc.com
TURN_DOMAIN=turn.superapp.vcijsc.com

# Đích S3 mặc định của egress (BE vẫn truyền đích theo từng yêu cầu). Bucket PRIVATE, prefix recordings/ (EGRESS_S3_PREFIX của BE).
EGRESS_S3_ACCESS_KEY_ID=
EGRESS_S3_SECRET_ACCESS_KEY=
EGRESS_S3_REGION=
EGRESS_S3_BUCKET=

# `edge` = nginx :443 (SNI: TURN/TLS + wss). BẮT BUỘC ở VM media riêng (production/khuyến nghị). Bỏ trống khi staging đơn-VM (443 thuộc nginx của VM app).
COMPOSE_PROFILES=edge
