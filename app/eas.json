{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "UPDATES_ENABLED": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://api-production-9c319.up.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://api-production-9c319.up.railway.app",
        "EXPO_PUBLIC_AUTH_ENABLED": "true",
        "UPDATES_ENABLED": "true",
        "APP_LINK_DOMAIN": "staging.superapp.vcijsc.com",
        "SENTRY_PROJECT": "superapp-app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://superapp.vcijsc.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://superapp.vcijsc.com",
        "EXPO_PUBLIC_AUTH_ENABLED": "true",
        "UPDATES_ENABLED": "true",
        "APP_LINK_DOMAIN": "superapp.vcijsc.com",
        "SENTRY_PROJECT": "superapp-app"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
