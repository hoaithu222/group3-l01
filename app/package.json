{
  "name": "super-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "autolinking": {
      "//": "p2-02 (2026-09-29): react-native-callkeep@4.3.16 KHONG CHAY duoc tren RN 0.86. RNCallKeepModule.java khai HAI @ReactMethod trung ten `displayIncomingCall` (dong 438 va 443, nap chong 3 va 4 tham so); bridge cu chap nhan, lop TurboModule interop cua kien truc moi tu choi: `TurboModuleInteropUtils$ParsingException: Module exports two methods to JavaScript with the same name`. index.js cua goi doc `NativeModules.RNCallKeep` o TAM MODULE nen CHI CAN import la nem -> AppRegistry.registerComponent khong chay -> app ket vinh vien o man hinh cho native (da bat tan tay bang logcat tren may ao 29/09). Loai khoi autolinking thi `NativeModules.RNCallKeep` chi la undefined, khong nem. Hai goi kia di kem cung lane, tat cung mot the. CAP NHAT (2026-09-29): patch da san sang o `app/patches/react-native-callkeep+4.3.16.patch` (xoa overload 3 tham so thua, giu ban 4 tham so ma index.js Android goi toi). VAN GIU TAT o day — chua build/chay tren thiet bi that de xac minh patch dung. Nguoi co thiet bi that: go 'react-native-callkeep' khoi danh sach exclude nay, `npm install` (patch-package tu ap qua postinstall), roi build lai dev client va thu cuoc goi den de kiem tra truoc khi go luon 2 goi kia (chua vá).",
      "exclude": [
        "react-native-callkeep",
        "react-native-incall-manager",
        "react-native-voip-push-notification"
      ]
    }
  },
  "scripts": {
    "start": "node scripts/ensure-dev-build.mjs && expo start --dev-client",
    "start:metro": "expo start --dev-client",
    "start:go": "expo start --go",
    "start:clear": "node scripts/ensure-dev-build.mjs && expo start --dev-client --clear",
    "start:metro:clear": "expo start --dev-client --clear",
    "start:android": "node scripts/ensure-dev-build.mjs && expo start --dev-client --android",
    "start:android:clear": "node scripts/ensure-dev-build.mjs && expo start --dev-client --clear --android",
    "ensure:dev-build": "node scripts/ensure-dev-build.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "distribute": "node scripts/distribute-android.mjs",
    "distribute:upload": "node scripts/distribute-android.mjs --upload-only",
    "distribute:dry": "node scripts/distribute-android.mjs --dry-run",
    "distribute:list": "node scripts/distribute-android.mjs --list",
    "typecheck": "node scripts/typed-routes.mjs && tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{app,src,scripts,tests}/**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"{app,src,scripts,tests}/**/*.{ts,tsx,js,mjs,json,css}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "postinstall": "patch-package",
    "generate:colors": "node scripts/generate-colors.mjs",
    "generate:typography": "node scripts/generate-typography.mjs",
    "generate:styles": "npm run generate:colors && npm run generate:typography && npm run generate:layout",
    "check:imports": "node scripts/check-imports.mjs",
    "check:orphans": "knip --no-progress --include files,dependencies",
    "check:dead": "knip --no-progress",
    "check:deps": "expo install --check",
    "check": "npm run typecheck && npm run lint && npm run check:imports && npm run check:classes && npm run check:contrast && npm run check:touch-targets && npm run check:file-size && npm test",
    "doctor": "npx --yes expo-doctor@latest",
    "generate:layout": "node scripts/generate-layout.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:classes": "node scripts/check-classes.mjs src app",
    "check:contrast": "node scripts/check-contrast.mjs src app",
    "check:touch-targets": "node scripts/check-touch-targets.mjs src app",
    "check:file-size": "node scripts/check-file-size.mjs src app",
    "sync:contracts": "node scripts/sync-contracts.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
