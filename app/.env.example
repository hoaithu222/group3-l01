# ─────────────────────────────────────────────────────────────────────────────
# Super App (mobile) — biến môi trường
#
# Chép file này thành `.env` rồi điền giá trị thật:  cp .env.example .env
#
# ⛔ MỌI biến có tiền tố EXPO_PUBLIC_ đều NẰM TRONG BUNDLE gửi tới máy người dùng.
#    Giải nén file .apk là đọc được. KHÔNG đặt secret (khoá ký, chuỗi kết nối
#    CSDL, private key, client_secret) ở đây.
#
# ⚠️ Đổi bất kỳ biến nào cũng phải KHỞI ĐỘNG LẠI Metro kèm cờ xoá cache:
#       npm run start:clear
#    Metro thay giá trị biến vào bundle LÚC BUILD rồi cache lại, nên sửa `.env`
#    mà chỉ reload app thì vẫn chạy giá trị cũ — không có cảnh báo nào.
# ─────────────────────────────────────────────────────────────────────────────


# ── LÚC BUILD — chỉ `app.config.ts` đọc, KHÔNG vào bundle ────────────────────

# Tên app hiển thị dưới icon
APP_NAME=Super App

# Định danh dự án trong Expo/EAS (chữ thường, gạch nối)
APP_SLUG=super-app

# Scheme cho deep link: `superapp://…`. Phải là DUY NHẤT trên máy —
# trùng scheme với app khác thì hệ điều hành mở nhầm app.
APP_SCHEME=superapp

# Định danh gói (quyết định D-14, xem docs/plan/decisions.md). ⛔ ĐỔI MỘT LẦN,
# TRƯỚC bản phát hành đầu tiên: sau khi đã lên store thì đổi package = một app
# HOÀN TOÀN MỚI, người dùng cũ không cập nhật được.
ANDROID_PACKAGE=com.mancode.vungnui
IOS_BUNDLE_ID=com.mancode.vungnui

# ID project trên EAS — chỉ cần khi build/submit bằng `eas build`.
# Bỏ trống thì `app.config.ts` không khai khối `eas` (không sao khi build local).
EAS_PROJECT_ID=

# Domain công khai dùng cho app links/universal links (lời mời, portfolio `/p`)
# — quyết định D-14. Cần file AASA/assetlinks tại `/.well-known/` trên domain
# này (phía BE lo, xem config-be.md §12).
APP_LINK_DOMAIN=superapp.vcijsc.com

# Bật expo-updates (cập nhật JS qua OTA) — chỉ cho profile preview/production.
# ⛔ Cần EAS_PROJECT_ID mới có tác dụng (xem app.config.ts).
UPDATES_ENABLED=false

# Thông báo đẩy (p0-06) — TUỲ CHỌN, chỉ `app.config.ts` đọc.
# `GOOGLE_SERVICES_JSON`: đường dẫn tới `google-services.json` của Firebase (Android). Trên EAS tạo biến
# kiểu FILE (EAS gán đường dẫn tệp tạm vào biến). Bỏ trống thì app vẫn build nhưng KHÔNG nhận được push.
# ⛔ Tệp là secret của dự án — không commit vào repo.
# `APS_ENVIRONMENT`: development | production — entitlement `aps-environment` của iOS (bản store = production).
GOOGLE_SERVICES_JSON=
APS_ENVIRONMENT=development


# ── LÚC CHẠY — code trong `src/` đọc qua process.env.EXPO_PUBLIC_… ───────────

# Môi trường: development | staging | production
EXPO_PUBLIC_ENV=development

# Gốc API — ⛔ KHÔNG kèm dấu "/" ở cuối.
#
# ⚠️ Máy ảo Android KHÔNG hiểu `localhost` (đó là chính máy ảo, không phải máy
#    dev). Ba trường hợp:
#      · Máy ảo Android (Android Studio) : http://10.0.2.2:3000/api/v1  (mặc định dưới đây)
#      · Máy thật cùng Wi-Fi với máy dev : http://<IP LAN của máy bạn>:3000/api/v1
#                                           (vd http://192.168.1.23:3000/api/v1 — lấy IP bằng
#                                           `ipconfig` trên Windows, mục "IPv4 Address")
#      · Máy ảo iOS (Simulator)          : http://localhost:3000/api/v1 (chạy chung máy nên được)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1

# Gốc Socket.IO — KHÔNG kèm `/api/v1`, cùng host/cổng với API ở trên.
# Đổi API_BASE_URL sang IP LAN/localhost thì SOCKET_URL cũng phải đổi tương ứng.
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:3000
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# ── Sentry (p0-11) ────────────────────────────────────────────────────────────
# DSN của project Sentry `superapp-app`, RIÊNG theo môi trường (staging/production). TRỐNG = tắt giám sát lỗi hoàn toàn (no-op).
# DSN không phải bí mật nhưng đừng commit giá trị thật: đặt qua biến môi trường EAS của từng profile (`eas env:create`), local để trống.
# ⚠️ `@sentry/react-native` + `expo-updates` là module native ⇒ thêm/nâng cấp phải BUILD LẠI dev client.
EXPO_PUBLIC_SENTRY_DSN=
# ── Đăng nhập Google (qua Firebase) ───────────────────────────────────────────
# OAuth client ID loại WEB của project Firebase: Firebase console → Authentication → Sign-in method → Google → "Web SDK configuration"
# → "Web client ID" (dạng `<số>-<chuỗi>.apps.googleusercontent.com`). Là ID CÔNG KHAI (không phải secret). TRỐNG = ẩn nút "Tiếp tục với Google".
# ⛔ Đừng dùng client ID loại Android. Chỉ Android (iOS chưa cấu hình). Muốn chạy được còn cần:
#   1) Provider Google đã BẬT trong Firebase Authentication;
#   2) SHA-1 (và SHA-256) của keystore ký bản build đã đăng ký cho app Android trong Firebase → tải lại `google-services.json`
#      (tệp mới có mục `oauth_client`; tệp không có mục đó ⇒ đăng nhập báo DEVELOPER_ERROR);
#   3) BUILD LẠI dev client — `@react-native-google-signin` và `@react-native-firebase/*` là module native.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# ── Bản đồ Mapbox (p6-05 In ấn O2O & địa điểm) ────────────────────────────────
# Token CÔNG KHAI `pk.…` (account.mapbox.com → Tokens). ⛔ Không bao giờ đặt token bí mật `sk.…` ở đây — biến này nằm trong bundle.
# TRỐNG = màn "Địa điểm" chỉ có chế độ DANH SÁCH (không sập). Có token vẫn cần BUILD LẠI dev client (`@rnmapbox/maps` là module native).
EXPO_PUBLIC_MAPBOX_TOKEN=
# Chỉ lúc BUILD (không vào bundle) — bật plugin upload source map khi có SENTRY_ORG; token là secret EAS:
#   SENTRY_ORG=<tổ-chức>   SENTRY_PROJECT=superapp-app   SENTRY_URL=https://sentry.io/   SENTRY_AUTH_TOKEN=<secret EAS, không đặt ở đây>

# Thời gian chờ tối đa mỗi request, mili-giây (mặc định 30000).
# Mạng di động chập chờn hơn hẳn mạng dây — đừng hạ dưới 15000.
EXPO_PUBLIC_API_TIMEOUT=30000

# Bật toast lỗi tập trung ở response interceptor: true | false (mặc định true)
EXPO_PUBLIC_ENABLE_ERROR_TOAST=true

# In log request/response ra console Metro: true | false (mặc định false)
EXPO_PUBLIC_ENABLE_API_LOGGING=false

# Kèm cả body/params vào log mạng: true | false (mặc định false)
# ⛔ Mặc định TẮT vì body của lượt đăng nhập chứa mật khẩu thật. Bật lên thì
#    tầng log vẫn che các khoá pass/secret/token, nhưng vẫn chỉ nên bật ở máy dev.
EXPO_PUBLIC_API_LOG_PAYLOAD=false

# Bật luồng làm mới token khi gặp 401: true | false (mặc định true)
# Đặt false khi BE chưa có endpoint refresh — lúc đó 401 là đăng xuất luôn.
EXPO_PUBLIC_ENABLE_REFRESH_TOKEN=true

# Bật kiểm đăng nhập ở tầng điều hướng: true | false
#
# ⛔ DỰ ÁN THẬT PHẢI ĐẶT `true` — Super App có backend thật từ Phase 0. Để
#    `false` nghĩa là MỌI màn hình mở cho người chưa đăng nhập; chỉ dùng tạm khi
#    dựng giao diện lúc BE chưa sẵn sàng.
EXPO_PUBLIC_AUTH_ENABLED=true

# Gốc link portfolio công khai (p6-07), KHÔNG kèm `/` cuối. Chỉ để hiển thị đường dẫn dự kiến khi hồ sơ chưa công khai
# (đã công khai thì dùng `publicUrl` do BE trả). Để trống ⇒ suy từ EXPO_PUBLIC_API_BASE_URL (bỏ `/api/v1`, thêm `/p`).
# Khớp `PUBLIC_PORTFOLIO_BASE_URL` của BE, vd: https://superapp.vcijsc.com/p
# EXPO_PUBLIC_PORTFOLIO_BASE_URL=
